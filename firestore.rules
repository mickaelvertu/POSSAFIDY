rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (
          exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE' &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN']
        )
      );
    }

    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function hasPermission(permission) {
      return isAdmin() || (
        isActiveUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.hasAny([permission])
      );
    }

    // User collection access rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin();
      allow create: if isAdmin() || (
        request.auth.uid == userId &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.role == null &&
        request.resource.data.permissions.size() == 0 &&
        request.resource.data.assignedStores.size() == 0
      ) &&
        request.resource.data.email is string &&
        request.resource.data.status in ['PENDING', 'ACTIVE', 'DISABLED'];
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'permissions', 'assignedStores']))
      );
      allow delete: if isAdmin() && userId != request.auth.uid;
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (adminId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isAdmin();
    }

    // Inventory master data. Administrators seed and maintain stores; active
    // users may read inventory, while stock adjustments require stock.adjust.
    match /stores/{storeId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /stocks/{stockId} {
      allow read: if isActiveUser();
      allow create, update: if hasPermission('stock.adjust');
      allow delete: if isAdmin();
    }
  }
}
