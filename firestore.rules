rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      let profile = currentProfile();
      return profile != null && profile.get('status', '') == 'ACTIVE' &&
        profile.get('role', '') in ['ADMIN', 'SUPER_ADMIN'];
    }

    function isSuperAdmin() {
      let profile = currentProfile();
      return profile != null && profile.get('status', '') == 'ACTIVE' && profile.get('role', '') == 'SUPER_ADMIN';
    }

    function isActiveUser() {
      let profile = currentProfile();
      return profile != null && profile.get('status', '') == 'ACTIVE';
    }

    function currentProfile() {
      return isSignedIn()
        ? get(/databases/$(database)/documents/users/$(request.auth.uid)).data : null;
    }

    function hasPermission(permission) {
      return hasAnyPermission([permission]);
    }

    function hasAnyPermission(permissions) {
      let profile = currentProfile();
      return profile != null && profile.get('status', '') == 'ACTIVE' &&
        (profile.get('role', '') in ['ADMIN', 'SUPER_ADMIN'] || profile.get('permissions', []).hasAny(permissions));
    }

    function hasStoreAccess(storeId) {
      let profile = currentProfile();
      return profile != null && profile.get('status', '') == 'ACTIVE' &&
        (profile.get('role', '') in ['ADMIN', 'SUPER_ADMIN'] ||
          (storeId is string && profile.get('assignedStores', []).hasAny([storeId])));
    }

    function canCollectReseller(storeId) {
      return hasPermission('credit.manage') || (isActiveUser() &&
        currentProfile().get('role', '') == 'RESPONSABLE_MAGASIN' && hasStoreAccess(storeId) &&
        get(/databases/$(database)/documents/stores/$(storeId)).data.store_type == 'CENTRAL_WAREHOUSE');
    }
    function resellerCollectorName() {
      let profile = currentProfile();
      let first = profile.get('firstName', '');
      let last = profile.get('lastName', '');
      return profile.get('displayName', '') != '' ? profile.displayName :
        (first != '' && last != '' ? first + ' ' + last :
          (first != '' ? first : (last != '' ? last : profile.get('name', request.auth.uid))));
    }
    function resellerDebtReduced(sale, amount, paidAt) {
      let customerId = sale.get('credit_customer_id', '');
      return customerId == '' || (
        getAfter(/databases/$(database)/documents/creditCustomers/$(customerId)).data.outstanding_balance ==
          get(/databases/$(database)/documents/creditCustomers/$(customerId)).data.outstanding_balance - amount &&
        getAfter(/databases/$(database)/documents/creditCustomers/$(customerId)).data.updated_at == paidAt &&
        getAfter(/databases/$(database)/documents/creditCustomers/$(customerId)).data.last_payment_sale_id == sale.id);
    }
    function validResellerPayment(before, after) {
      let history = before.get('credit_payments', []);
      let previous = history == null ? [] : history;
      let payments = after.credit_payments;
      let payment = payments[payments.size() - 1];
      let receipt = getAfter(/databases/$(database)/documents/resellerReceipts/$(payment.id)).data;
      return before.customer_type == 'REVENDEUR' && before.status == 'VALIDATED' && after.status == 'VALIDATED' &&
        payments.size() == previous.size() + 1 && payments.removeAll([payment]) == previous &&
        payment.amount is int && payment.amount > 0 &&
        after.amount_paid == before.amount_paid + payment.amount &&
        payment.collected_by == request.auth.uid && payment.recorded_by == request.auth.uid &&
        payment.paid_at is number && payment.collected_by_name is string &&
        !exists(/databases/$(database)/documents/resellerReceipts/$(payment.id)) &&
        receipt.sale_id == before.id && receipt.amount == payment.amount && receipt.method == payment.method &&
        receipt.collected_by == payment.collected_by && receipt.paid_at == payment.paid_at &&
        receipt.collected_by_name == payment.collected_by_name && receipt.destination == payment.cash_destination &&
        resellerDebtReduced(before, payment.amount, payment.paid_at);
    }
    function validInitialResellerPayment(sale) {
      let payment = sale.credit_payments[0];
      let receipt = getAfter(/databases/$(database)/documents/resellerReceipts/$(payment.id)).data;
      return sale.customer_type == 'REVENDEUR' && sale.seller_id == request.auth.uid &&
        sale.credit_payments.size() == 1 && payment.id == 'initial-' + sale.id &&
        payment.amount == (sale.amount_paid > sale.total ? sale.total : sale.amount_paid) && payment.amount > 0 &&
        payment.method == sale.payment_method && payment.paid_at == sale.created_at &&
        payment.collected_by == request.auth.uid && payment.recorded_by == request.auth.uid &&
        receipt.sale_id == sale.id && receipt.amount == payment.amount && receipt.paid_at == payment.paid_at &&
        receipt.method == payment.method && receipt.collected_by_name == payment.collected_by_name &&
        receipt.destination == payment.cash_destination;
    }
    function claimedResellerReceipt(h, index) {
      let receipt = index >= h.receipt_ids.size() ? null :
        getAfter(/databases/$(database)/documents/resellerReceipts/$(h.receipt_ids[index])).data;
      return index >= h.receipt_ids.size() || (receipt.handover_id == h.id && receipt.collected_by == h.declared_by &&
        receipt.store_id == h.store_id && receipt.business_date == h.business_date &&
        receipt.method == 'CASH' && receipt.destination == 'HANDOVER');
    }
    function resellerReceiptAmount(h, index) {
      return index >= h.receipt_ids.size() ? 0 :
        getAfter(/databases/$(database)/documents/resellerReceipts/$(h.receipt_ids[index])).data.amount;
    }
    function validDepHandover(h) {
      return h.get('payment_method', 'CASH') == 'CASH' && h.receipt_ids is list && h.receipt_ids.size() > 0 && h.receipt_ids.size() <= 5 &&
        h.receipt_ids.toSet().size() == h.receipt_ids.size() &&
        claimedResellerReceipt(h, 0) && claimedResellerReceipt(h, 1) && claimedResellerReceipt(h, 2) &&
        claimedResellerReceipt(h, 3) && claimedResellerReceipt(h, 4) &&
        h.declared_amount == resellerReceiptAmount(h, 0) + resellerReceiptAmount(h, 1) + resellerReceiptAmount(h, 2) +
          resellerReceiptAmount(h, 3) + resellerReceiptAmount(h, 4) &&
        h.expected_cash_sales == h.declared_amount && h.cash_sale_count == h.receipt_ids.size();
    }

    match /resellerReceipts/{receiptId} {
      allow get: if resource == null && isActiveUser() && (hasPermission('credit.manage') ||
        currentProfile().get('role', '') == 'RESPONSABLE_MAGASIN');
      allow read: if (hasPermission('credit.manage') || hasAnyPermission(['cash_handover.view', 'cash_handover.create',
        'cash_handover.receive', 'cash_handover.deposit']) || canCollectReseller(resource.data.store_id)) && hasStoreAccess(resource.data.store_id);
      allow create: if canCollectReseller(request.resource.data.store_id) && hasStoreAccess(request.resource.data.store_id) &&
        (request.resource.data.method != 'CASH' ||
          get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type != 'CENTRAL_WAREHOUSE' ||
          isAdmin() || currentProfile().get('role', '') == 'RESPONSABLE_MAGASIN') &&
        request.resource.data.keys().hasOnly(['id', 'sale_id', 'store_id', 'amount', 'method', 'paid_at', 'business_date',
          'collected_by', 'collected_by_name', 'recorded_by', 'recorded_by_name', 'destination', 'handover_id']) &&
        request.resource.data.id == receiptId && request.resource.data.collected_by == request.auth.uid &&
        request.resource.data.recorded_by == request.auth.uid && request.resource.data.collected_by_name is string &&
        request.resource.data.collected_by_name == resellerCollectorName() &&
        request.resource.data.recorded_by_name == request.resource.data.collected_by_name &&
        request.resource.data.recorded_by_name is string && request.resource.data.business_date is string &&
        request.resource.data.amount is int && request.resource.data.amount > 0 && request.resource.data.amount <= 9007199254740991 &&
        request.resource.data.method in ['CASH', 'MVOLA', 'AIRTEL_MONEY', 'ORANGE_MONEY', 'BANK_TRANSFER', 'CHECK', 'OTHER'] &&
        request.resource.data.paid_at is int && request.resource.data.paid_at >= request.time.toMillis() - 300000 &&
        request.resource.data.paid_at <= request.time.toMillis() + 60000 &&
        request.resource.data.business_date.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$') &&
        int(request.resource.data.business_date.split('-')[0]) == timestamp.value(request.resource.data.paid_at + 10800000).year() &&
        int(request.resource.data.business_date.split('-')[1]) == timestamp.value(request.resource.data.paid_at + 10800000).month() &&
        int(request.resource.data.business_date.split('-')[2]) == timestamp.value(request.resource.data.paid_at + 10800000).day() &&
        request.resource.data.handover_id == '' &&
        request.resource.data.destination == (isAdmin() && request.resource.data.method == 'CASH' ? 'TREASURY' : 'HANDOVER') &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.sale_id)).data.store_id == request.resource.data.store_id &&
        ((exists(/databases/$(database)/documents/sales/$(request.resource.data.sale_id)) && validResellerPayment(
          get(/databases/$(database)/documents/sales/$(request.resource.data.sale_id)).data,
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.sale_id)).data)) ||
         (!exists(/databases/$(database)/documents/sales/$(request.resource.data.sale_id)) &&
          validInitialResellerPayment(getAfter(/databases/$(database)/documents/sales/$(request.resource.data.sale_id)).data))) &&
        (request.resource.data.destination != 'TREASURY' || (
          !exists(/databases/$(database)/documents/treasuryFunds/$('reseller-' + receiptId)) &&
          getAfter(/databases/$(database)/documents/treasuryFunds/$('reseller-' + receiptId)).data.owner_id == request.auth.uid &&
          getAfter(/databases/$(database)/documents/treasuryFunds/$('reseller-' + receiptId)).data.balance == request.resource.data.amount));
      function validClaim() {
        let before = resource.data;
        let after = request.resource.data;
        let h = getAfter(/databases/$(database)/documents/cashHandovers/$(after.handover_id)).data;
        return isActiveUser() && before.collected_by == request.auth.uid &&
          before.destination == 'HANDOVER' && before.method == 'CASH' && before.handover_id == '' &&
          after.diff(before).affectedKeys().hasOnly(['handover_id']) &&
          after.handover_id is string && after.handover_id != '' &&
          !exists(/databases/$(database)/documents/cashHandovers/$(after.handover_id)) &&
          h.declared_by == request.auth.uid && h.store_id == before.store_id &&
          h.business_date == before.business_date && receiptId in h.receipt_ids;
      }
      allow update: if validClaim();
      allow delete: if false;
    }

    function canStoreArticle(storeId, articleId) {
      return get(/databases/$(database)/documents/stores/$(storeId)).data.store_type in ['CENTRAL_WAREHOUSE', 'MANUFACTURER'] ||
        get(/databases/$(database)/documents/articles/$(articleId)).data.article_type == 'RESALE';
    }

    // Large POS receipts must not read one catalog document per line: an
    // atomic transaction has a shared document-access budget. Trust only an
    // already approved and shipped central transfer, completed in this commit.
    function canCreditPosReceipt(data, delta) {
      let receipt = data.get('transfer_receipt', {});
      let transferId = receipt.get('transfer_id', '');
      let index = receipt.get('line_index', -1);
      let before = get(/databases/$(database)/documents/transfers/$(transferId)).data;
      let after = getAfter(/databases/$(database)/documents/transfers/$(transferId)).data;
      return transferId != '' && index is int && index >= 0 &&
        index < before.lines.size() && index < after.lines.size() &&
        before.type == 'CENTRAL_TO_POS' && before.status == 'IN_TRANSIT' &&
        before.approved_by is string && before.shipped_by is string &&
        after.status in ['VALIDATED', 'DISCREPANCY'] &&
        after.received_by == request.auth.uid && after.validated_by == request.auth.uid &&
        hasPermission('transfers.receive') && hasStoreAccess(before.destination_store_id) &&
        request.auth.uid != before.requested_by && request.auth.uid != before.approved_by &&
        data.store_id == before.destination_store_id &&
        get(/databases/$(database)/documents/stores/$(before.destination_store_id)).data.store_type == 'POS' &&
        get(/databases/$(database)/documents/stores/$(before.source_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
        before.lines[index].article_id == data.article_id &&
        after.lines[index].article_id == before.lines[index].article_id &&
        after.lines[index].quantity_sent == before.lines[index].quantity_sent &&
        after.lines[index].quantity_accepted > 0 &&
        after.lines[index].quantity_accepted <= after.lines[index].quantity_received &&
        after.lines[index].quantity_received <= before.lines[index].quantity_sent &&
        delta == after.lines[index].quantity_accepted;
    }

    // A shipment shares one transfer lookup across every line of the commit.
    function canDebitShipment(data, delta) {
      let proof = data.get('transfer_shipment', {});
      let id = proof.get('transfer_id', '');
      let index = proof.get('line_index', -1);
      let before = get(/databases/$(database)/documents/transfers/$(id)).data;
      let after = getAfter(/databases/$(database)/documents/transfers/$(id)).data;
      return id != '' && index is int && index >= 0 && index < before.lines.size() &&
        before.status == 'APPROVED' && after.status == 'IN_TRANSIT' &&
        before.lines == after.lines && before.source_store_id == data.store_id &&
        before.lines[index].article_id == data.article_id &&
        before.lines[index].quantity_sent > 0 && delta == -before.lines[index].quantity_sent &&
        before.type != 'RECYCLING' && after.shipped_by == request.auth.uid &&
        hasPermission('transfers.ship') && hasStoreAccess(before.source_store_id);
    }

    function canDebitCheckedSale(data, delta) {
      let link = data.sale_check;
      let check = get(/databases/$(database)/documents/saleCatalogChecks/$(link.check_id)).data;
      let before = get(/databases/$(database)/documents/sales/$(check.sale_id)).data;
      let after = getAfter(/databases/$(database)/documents/sales/$(check.sale_id)).data;
      return link.article_index is int && link.article_index >= 0 && link.article_index < check.article_ids.size() &&
        check.article_ids[link.article_index] == data.article_id && check.created_by == request.auth.uid &&
        data.get('reference_id', check.sale_id) == check.sale_id &&
        check.store_id == data.store_id && before.store_id == data.store_id &&
        check.sale_created_at == before.created_at && check.sale_lines == before.lines &&
        before.lines == after.lines &&
        ((before.customer_type == 'REVENDEUR' && before.status == 'APPROVED') ||
          (before.customer_type != 'REVENDEUR' && before.status == 'VERIFIED')) &&
        after.status == 'VALIDATED' && after.validated_by == request.auth.uid && delta < 0 &&
        hasPermission('sales.validate') && hasStoreAccess(data.store_id);
    }

    match /saleCatalogChecks/{checkId} {
      function eligible(data, index) {
        let ids = data.article_ids;
        let indexes = data.line_indexes;
        let lines = data.sale_lines;
        return index >= ids.size() ||
          (indexes[index] is int && indexes[index] >= 0 &&
            lines[indexes[index]].article_id == ids[index] &&
            get(/databases/$(database)/documents/articles/$(ids[index])).data.article_type == 'RESALE');
      }
      function valid(data) {
        let sale = get(/databases/$(database)/documents/sales/$(data.sale_id)).data;
        return hasPermission('sales.validate') && hasStoreAccess(data.store_id) &&
          data.keys().hasOnly(['sale_id', 'store_id', 'sale_created_at', 'sale_lines', 'article_ids', 'line_indexes', 'created_by']) &&
          data.created_by == request.auth.uid && data.article_ids is list &&
          data.article_ids.size() > 0 && data.article_ids.size() <= 7 &&
          data.line_indexes is list && data.line_indexes.size() == data.article_ids.size() &&
          sale.store_id == data.store_id && sale.created_at == data.sale_created_at &&
          sale.lines == data.sale_lines && sale.status in ['VERIFIED', 'APPROVED'] &&
          eligible(data, 0) && eligible(data, 1) && eligible(data, 2) && eligible(data, 3) &&
          eligible(data, 4) && eligible(data, 5) && eligible(data, 6);
      }
      allow create: if valid(request.resource.data);
      // Immutable attestations cannot be forged or altered by a later stock update.
      allow delete: if isSuperAdmin();
    }

    function canViewArticleType(articleType) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSuperAdmin() || (
        isActiveUser() && (
          (hasPermission('procurement.manage') && articleType in ['RAW_MATERIAL', 'RESALE']) ||
          ('visibleArticleTypes' in profile && profile.visibleArticleTypes.hasAny([articleType])) ||
          (!('visibleArticleTypes' in profile) && (
            profile.role in ['ADMIN', 'MAGASINIER', 'RESPONSABLE_MAGASIN', 'PRODUCTION'] ||
            (profile.role in ['VENDEUR', 'GESTIONNAIRE_CREDIT', 'REVENDEUR'] && articleType == 'RESALE')
          ))
        )
      );
    }

    // User collection access rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || (isActiveUser() && resource.data.role == 'RESPONSABLE_MAGASIN');
      allow create: if (
        isSuperAdmin() ||
        (isAdmin() && !(request.resource.data.role in ['ADMIN', 'SUPER_ADMIN'])) ||
        (
          request.auth.uid == userId &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.role == null &&
          request.resource.data.permissions.size() == 0 &&
          request.resource.data.assignedStores.size() == 0
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.role == 'REVENDEUR' &&
          request.resource.data.businessName is string &&
          request.resource.data.businessName.size() >= 2 &&
          request.resource.data.firstName is string &&
          request.resource.data.firstName.size() >= 2 &&
          request.resource.data.lastName is string &&
          request.resource.data.lastName.size() >= 2 &&
          request.resource.data.phone is string &&
          request.resource.data.phone.size() >= 5 &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.permissions.size() == 0 &&
          request.resource.data.assignedStores.size() == 0 &&
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'firstName', 'lastName', 'businessName',
            'phone', 'status', 'role', 'permissions', 'assignedStores',
            'createdAt', 'updatedAt'
          ])
        )
      ) &&
        request.resource.data.email is string &&
        request.resource.data.status in ['PENDING', 'ACTIVE', 'DISABLED'];
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && !(resource.data.role in ['ADMIN', 'SUPER_ADMIN']) && !(request.resource.data.role in ['ADMIN', 'SUPER_ADMIN'])) ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'permissions', 'assignedStores']))
      );
      allow delete: if false;
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (adminId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /userConnections/{connectionId} {
      allow read: if isAdmin();
      allow create: if isActiveUser() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.keys().hasOnly(['user_id', 'connected_at', 'heartbeat_at']) &&
        request.resource.data.connected_at == request.time &&
        request.resource.data.heartbeat_at == request.time;
      allow update: if isActiveUser() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.keys().hasOnly(['user_id', 'connected_at', 'heartbeat_at']) &&
        request.resource.data.connected_at == resource.data.connected_at &&
        request.resource.data.heartbeat_at == request.time;
      allow delete: if isActiveUser() && resource.data.user_id == request.auth.uid;
    }

    match /inventoryMetadata/{documentId} {
      allow read, write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if isActiveUser() && canViewArticleType(resource.data.article_type);
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read: if isAdmin() || hasPermission('procurement.manage');
      allow create, update: if hasPermission('procurement.manage');
      allow delete: if false;
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() || (isActiveUser() && resource.data.get('user_id', null) == request.auth.uid);
      allow create: if isAdmin() || (
        request.auth.uid == employeeId &&
        request.resource.data.keys().hasOnly([
          'id', 'user_id', 'first_name', 'last_name', 'position', 'email',
          'phone', 'application_status', 'is_active', 'created_at', 'updated_at'
        ]) &&
        request.resource.data.keys().hasAll([
          'id', 'user_id', 'first_name', 'last_name', 'position', 'email',
          'application_status', 'is_active', 'created_at', 'updated_at'
        ]) &&
        request.resource.data.id == employeeId &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.application_status == 'PENDING' &&
        request.resource.data.is_active == false &&
        request.resource.data.first_name is string &&
        request.resource.data.first_name.size() > 0 &&
        request.resource.data.last_name is string &&
        request.resource.data.last_name.size() > 0 &&
        request.resource.data.position is string &&
        request.resource.data.position.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.created_at is number &&
        request.resource.data.updated_at is number &&
        (!('phone' in request.resource.data) || request.resource.data.phone is string) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'PENDING' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == request.resource.data.email
      );
      allow update, delete: if isAdmin();
    }

    match /payroll/{payslipId} {
      allow read: if isAdmin() || (isActiveUser() &&
        get(/databases/$(database)/documents/employees/$(resource.data.employee_id)).data.get('user_id', null) == request.auth.uid);
      allow write: if isAdmin();
    }

    match /salaryAdvances/{advanceId} {
      allow read: if isAdmin() || (isActiveUser() &&
        get(/databases/$(database)/documents/employees/$(resource.data.employee_id)).data.get('user_id', null) == request.auth.uid);
      allow write: if isAdmin();
    }

    match /cashHandovers/{handoverId} {
      allow get: if resource == null && hasPermission('cash_handover.create');
      allow read: if (
        hasPermission('cash_handover.view') ||
        hasPermission('cash_handover.create') ||
        hasPermission('cash_handover.receive') ||
        hasPermission('cash_handover.deposit')
      ) && hasStoreAccess(resource.data.store_id);
      allow create: if hasPermission('cash_handover.create') &&
        hasStoreAccess(request.resource.data.store_id) &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.store_id)) &&
        (get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type == 'POS' ||
          (get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            currentProfile().get('role', '') in ['RESPONSABLE_MAGASIN', 'ADMIN', 'SUPER_ADMIN'] &&
            validDepHandover(request.resource.data))) &&
        request.resource.data.id == handoverId &&
        request.resource.data.handover_number is string &&
        request.resource.data.business_date is string &&
        request.resource.data.store_name is string &&
        request.resource.data.declared_by_name is string &&
        request.resource.data.declared_at is number &&
        request.resource.data.cash_sale_count is number &&
        request.resource.data.cash_sale_count >= 0 &&
        request.resource.data.status == 'DECLARED' &&
        request.resource.data.declared_by == request.auth.uid &&
        request.resource.data.declared_amount is number &&
        request.resource.data.declared_amount >= 0 &&
        request.resource.data.expected_cash_sales is number &&
        request.resource.data.expected_cash_sales >= 0 &&
        request.resource.data.deposited_amount == 0 &&
        request.resource.data.deposits is list &&
        request.resource.data.deposits.size() == 0 &&
        (!('payment_method' in request.resource.data) || request.resource.data.payment_method in ['CASH', 'MVOLA', 'OTHER']) &&
        (!('reference_note' in request.resource.data) || request.resource.data.reference_note is string) &&
        request.resource.data.keys().hasAll([
          'id', 'handover_number', 'store_id', 'store_name', 'business_date',
          'expected_cash_sales', 'cash_sale_count', 'declared_amount',
          'declared_by', 'declared_by_name', 'declared_at', 'status',
          'deposited_amount', 'deposits'
        ]) &&
        request.resource.data.keys().hasOnly([
          'receipt_ids', 'id', 'handover_number', 'store_id', 'store_name', 'business_date',
          'expected_cash_sales', 'cash_sale_count', 'declared_amount',
          'declared_by', 'declared_by_name', 'declared_at', 'status',
          'deposited_amount', 'deposits', 'payment_method', 'reference_note'
        ]);
      allow update: if (
        hasPermission('cash_handover.receive') &&
        hasStoreAccess(resource.data.store_id) &&
        resource.data.status == 'DECLARED' &&
        resource.data.declared_by != request.auth.uid &&
        request.resource.data.status in ['RECEIVED', 'DISCREPANCY'] &&
        request.resource.data.received_amount is number &&
        request.resource.data.received_amount >= 0 &&
        request.resource.data.received_by == request.auth.uid &&
        request.resource.data.received_at is number &&
        (!('treasury_fund_id' in request.resource.data) || (
          isAdmin() && request.resource.data.allocated_amount == 0 &&
          request.resource.data.treasury_fund_id == 'pos-' + handoverId &&
          getAfter(/databases/$(database)/documents/treasuryFunds/$(request.resource.data.treasury_fund_id)).data.balance == request.resource.data.received_amount
        )) &&
        (
          (request.resource.data.received_amount == resource.data.declared_amount &&
            request.resource.data.status == 'RECEIVED') ||
          (request.resource.data.received_amount != resource.data.declared_amount &&
            request.resource.data.status == 'DISCREPANCY' &&
            request.resource.data.get('discrepancy_note', '') is string &&
            request.resource.data.get('discrepancy_note', '').size() > 0)
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'received_amount', 'received_by', 'received_by_name',
          'received_at', 'discrepancy_note', 'treasury_fund_id', 'allocated_amount'
        ])
      ) || (
        hasPermission('cash_handover.deposit') &&
        hasStoreAccess(resource.data.store_id) &&
        resource.data.status in ['RECEIVED', 'DISCREPANCY', 'PARTIALLY_DEPOSITED'] &&
        request.resource.data.deposits is list &&
        request.resource.data.deposits.size() == resource.data.deposits.size() + 1 &&
        request.resource.data.deposits.hasAll(resource.data.deposits) &&
        request.resource.data.deposited_amount is number &&
        request.resource.data.deposited_amount ==
          resource.data.deposited_amount +
          request.resource.data.deposits[request.resource.data.deposits.size() - 1].amount &&
        request.resource.data.deposited_amount <= resource.data.received_amount - resource.data.get('allocated_amount', 0) &&
        (!('treasury_fund_id' in resource.data) || validHandoverTreasuryDeposit()) &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].amount is number &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].amount > 0 &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].bank_name is string &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].bank_name.size() > 0 &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].reference is string &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].reference.size() > 0 &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].deposited_by == request.auth.uid &&
        request.resource.data.deposits[request.resource.data.deposits.size() - 1].deposited_at is number &&
        (
          (request.resource.data.deposited_amount == resource.data.received_amount &&
            request.resource.data.status == 'DEPOSITED') ||
          (request.resource.data.deposited_amount < resource.data.received_amount &&
            request.resource.data.status == 'PARTIALLY_DEPOSITED')
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'deposits', 'deposited_amount', 'status', 'treasury_movement_id'
        ])
      );
      allow update: if validHandoverAllocation();
      allow update: if validHandoverRefund();
      allow update: if isAdmin() && resource.data.received_by == request.auth.uid &&
        !('treasury_fund_id' in resource.data) && resource.data.status in ['RECEIVED', 'DISCREPANCY', 'PARTIALLY_DEPOSITED'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['treasury_fund_id', 'allocated_amount']) &&
        request.resource.data.allocated_amount == 0 && request.resource.data.treasury_fund_id == 'pos-' + handoverId &&
        !exists(/databases/$(database)/documents/treasuryFunds/$(request.resource.data.treasury_fund_id)) &&
        getAfter(/databases/$(database)/documents/treasuryFunds/$(request.resource.data.treasury_fund_id)).data.balance == resource.data.received_amount - resource.data.deposited_amount;
      allow delete: if false;
    }

    // Treasury is restricted to active administrators. Every balance change
    // requires a new immutable movement in the same atomic commit.
    function treasuryDebit(m, id) {
      let before = get(/databases/$(database)/documents/treasuryFunds/$(m.fund_id)).data;
      let after = getAfter(/databases/$(database)/documents/treasuryFunds/$(m.fund_id)).data;
      return before.owner_id == request.auth.uid && m.from_user == before.owner_id &&
        before.balance >= m.amount && after.balance == before.balance - m.amount &&
        after.last_movement_id == id;
    }
    function treasuryCredit(m, id) {
      let f = getAfter(/databases/$(database)/documents/treasuryFunds/$(m.destination_fund_id)).data;
      return !exists(/databases/$(database)/documents/treasuryFunds/$(m.destination_fund_id)) &&
        f.owner_id == m.to_user && f.initial_amount == m.amount && f.balance == m.amount && f.last_movement_id == id;
    }
    function treasuryPurchase(m) {
      let before = get(/databases/$(database)/documents/purchases/$(m.purchase_id)).data;
      let after = getAfter(/databases/$(database)/documents/purchases/$(m.purchase_id)).data;
      let payment = after.payments[after.payments.size() - 1];
      return after.payments.size() == before.payments.size() + 1 &&
        payment.id == m.id && payment.treasury_fund_id == m.fund_id &&
        payment.amount == m.amount && payment.paid_by == request.auth.uid;
    }
    function treasuryExpense(m) {
      let before = get(/databases/$(database)/documents/expenses/$(m.expense_id)).data;
      let after = getAfter(/databases/$(database)/documents/expenses/$(m.expense_id)).data;
      return !('treasury_movement_id' in before) &&
        ((before.status == 'DRAFT' && before.payment_status == 'PAID') ||
          (before.status == 'VALIDATED' && before.payment_status == 'PENDING')) &&
        after.status == 'VALIDATED' && after.payment_status == 'PAID' &&
        after.treasury_fund_id == m.fund_id && after.treasury_movement_id == m.id &&
        after.amount == m.amount && after.paid_by == request.auth.uid && after.paid_at == m.created_at;
    }
    function treasuryExpenseRefund(m) {
      let before = get(/databases/$(database)/documents/expenses/$(m.expense_id)).data;
      let after = getAfter(/databases/$(database)/documents/expenses/$(m.expense_id)).data;
      let payment = get(/databases/$(database)/documents/treasuryMovements/$(before.treasury_movement_id)).data;
      let fund = get(/databases/$(database)/documents/treasuryFunds/$(m.destination_fund_id)).data;
      let credited = getAfter(/databases/$(database)/documents/treasuryFunds/$(m.destination_fund_id)).data;
      return before.get('status', 'VALIDATED') != 'CANCELLED' && after.status == 'CANCELLED' &&
        after.cancelled_by == request.auth.uid && after.cancelled_at == m.created_at &&
        after.treasury_reversal_id == m.id && m.fund_id == '' && m.from_user == '' &&
        m.destination_fund_id == before.treasury_fund_id && m.to_user == fund.owner_id &&
        payment.kind == 'EXPENSE' && payment.expense_id == m.expense_id &&
        payment.fund_id == m.destination_fund_id && payment.from_user == fund.owner_id &&
        payment.amount == m.amount && m.amount == before.amount &&
        credited.balance == fund.balance + m.amount && credited.last_movement_id == m.id;
    }
    function treasuryRefundAllocation(m) {
      let fund = get(/databases/$(database)/documents/treasuryFunds/$(m.destination_fund_id)).data;
      return fund.handover_id == '' || (
        getAfter(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.allocated_amount ==
          get(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.allocated_amount - m.amount &&
        getAfter(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.allocated_amount >= 0 &&
        getAfter(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.treasury_movement_id == m.id);
    }
    function treasuryPosDeposit(m) {
      let fund = get(/databases/$(database)/documents/treasuryFunds/$(m.fund_id)).data;
      return fund.handover_id == '' || (
        getAfter(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.deposited_amount ==
          get(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.deposited_amount + m.amount &&
        getAfter(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.treasury_movement_id == m.id);
    }
    function treasuryAllocated(m) {
      let fund = get(/databases/$(database)/documents/treasuryFunds/$(m.fund_id)).data;
      return fund.handover_id == '' || (
        getAfter(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.allocated_amount ==
          get(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.get('allocated_amount', 0) + m.amount &&
        getAfter(/databases/$(database)/documents/cashHandovers/$(fund.handover_id)).data.treasury_movement_id == m.id);
    }
    function treasuryReceiptSource(f) {
      return (f.source in ['BANK', 'OTHER', 'OPENING'] && f.handover_id == '') ||
        (f.source == 'POS' && f.id == 'pos-' + f.handover_id &&
          (get(/databases/$(database)/documents/cashHandovers/$(f.handover_id)).data.status == 'DECLARED' ||
            (!('treasury_fund_id' in get(/databases/$(database)/documents/cashHandovers/$(f.handover_id)).data) &&
              get(/databases/$(database)/documents/cashHandovers/$(f.handover_id)).data.received_by == request.auth.uid)) &&
          getAfter(/databases/$(database)/documents/cashHandovers/$(f.handover_id)).data.received_by == request.auth.uid &&
          getAfter(/databases/$(database)/documents/cashHandovers/$(f.handover_id)).data.received_amount -
            getAfter(/databases/$(database)/documents/cashHandovers/$(f.handover_id)).data.deposited_amount == f.balance &&
          getAfter(/databases/$(database)/documents/cashHandovers/$(f.handover_id)).data.treasury_fund_id == f.id);
    }
    function treasuryTransferSource(f, m) {
      let original = get(/databases/$(database)/documents/treasuryFunds/$(m.fund_id)).data;
      let recipient = get(/databases/$(database)/documents/users/$(f.owner_id)).data;
      return f.handover_id == '' && f.source == original.source &&
        f.source_reference == original.source_reference && f.owner_id != request.auth.uid &&
        recipient.status == 'ACTIVE' && recipient.role in ['ADMIN', 'SUPER_ADMIN'];
    }
    match /treasuryMovements/{movementId} {
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.keys().hasOnly([
        'id', 'kind', 'fund_id', 'destination_fund_id', 'from_user', 'to_user', 'amount', 'reference', 'purchase_id', 'expense_id', 'created_by', 'created_at'
      ]) && request.resource.data.id == movementId && request.resource.data.created_by == request.auth.uid &&
        request.resource.data.amount is int && request.resource.data.amount > 0 &&
        request.resource.data.reference is string && request.resource.data.reference.size() > 0 &&
        request.resource.data.created_at is number && (
          (request.resource.data.kind == 'RECEIPT' && request.resource.data.fund_id == '' && request.resource.data.from_user == '' &&
            request.resource.data.to_user == request.auth.uid && treasuryCredit(request.resource.data, movementId)) ||
          (request.resource.data.kind == 'TRANSFER' && treasuryDebit(request.resource.data, movementId) &&
            treasuryCredit(request.resource.data, movementId) && treasuryAllocated(request.resource.data)) ||
          (request.resource.data.kind == 'PURCHASE' && request.resource.data.destination_fund_id == '' &&
            treasuryDebit(request.resource.data, movementId) && treasuryPurchase(request.resource.data) && treasuryAllocated(request.resource.data)) ||
          (request.resource.data.kind == 'EXPENSE' && request.resource.data.destination_fund_id == '' &&
            treasuryDebit(request.resource.data, movementId) && treasuryExpense(request.resource.data) && treasuryAllocated(request.resource.data)) ||
          (request.resource.data.kind == 'EXPENSE_REFUND' && treasuryExpenseRefund(request.resource.data) && treasuryRefundAllocation(request.resource.data)) ||
          (request.resource.data.kind == 'DEPOSIT' && request.resource.data.destination_fund_id == '' &&
            treasuryDebit(request.resource.data, movementId) && treasuryPosDeposit(request.resource.data))
        );
      allow update, delete: if false;
    }
    match /treasuryFunds/{fundId} {
      function validCreation() {
        let f = request.resource.data;
        let m = getAfter(/databases/$(database)/documents/treasuryMovements/$(f.last_movement_id)).data;
        return f.keys().hasOnly(['id', 'owner_id', 'owner_name', 'source', 'source_reference', 'handover_id', 'initial_amount', 'balance', 'created_at', 'last_movement_id']) &&
          f.id == fundId && f.balance is int && f.balance > 0 && f.initial_amount == f.balance &&
          f.owner_name is string && f.source_reference is string && f.source_reference.size() > 0 &&
          f.created_at is number && !exists(/databases/$(database)/documents/treasuryMovements/$(f.last_movement_id)) &&
          m.destination_fund_id == fundId && m.to_user == f.owner_id && m.amount == f.balance && (
            (m.kind == 'RECEIPT' && f.owner_id == request.auth.uid && treasuryReceiptSource(f)) ||
            (m.kind == 'TRANSFER' && treasuryTransferSource(f, m)));
      }
      function validDebit() {
        let f = request.resource.data;
        let m = getAfter(/databases/$(database)/documents/treasuryMovements/$(f.last_movement_id)).data;
        return resource.data.owner_id == request.auth.uid && f.balance is int && f.balance >= 0 &&
          f.diff(resource.data).affectedKeys().hasOnly(['balance', 'last_movement_id']) &&
          !exists(/databases/$(database)/documents/treasuryMovements/$(f.last_movement_id)) &&
          m.kind in ['TRANSFER', 'PURCHASE', 'EXPENSE', 'DEPOSIT'] && m.fund_id == fundId &&
          m.amount > 0 && f.balance == resource.data.balance - m.amount;
      }
      allow read: if isAdmin();
      allow create: if isAdmin() && validCreation();
      allow update: if isAdmin() && validDebit();
      allow update: if isAdmin() && request.resource.data.balance is int && request.resource.data.balance >= 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['balance', 'last_movement_id']) &&
        !exists(/databases/$(database)/documents/treasuryMovements/$(request.resource.data.last_movement_id)) &&
        getAfter(/databases/$(database)/documents/treasuryMovements/$(request.resource.data.last_movement_id)).data.kind == 'EXPENSE_REFUND' &&
        getAfter(/databases/$(database)/documents/treasuryMovements/$(request.resource.data.last_movement_id)).data.destination_fund_id == fundId &&
        treasuryExpenseRefund(getAfter(/databases/$(database)/documents/treasuryMovements/$(request.resource.data.last_movement_id)).data);
      allow delete: if false;
    }
    function validHandoverAllocation() {
      let before = resource.data;
      let after = request.resource.data;
      let m = getAfter(/databases/$(database)/documents/treasuryMovements/$(after.treasury_movement_id)).data;
      return isAdmin() && before.received_by == request.auth.uid &&
        after.diff(before).affectedKeys().hasOnly(['allocated_amount', 'treasury_movement_id']) &&
        m.kind in ['TRANSFER', 'PURCHASE', 'EXPENSE'] && m.fund_id == before.treasury_fund_id &&
        !exists(/databases/$(database)/documents/treasuryMovements/$(after.treasury_movement_id)) &&
        after.allocated_amount == before.get('allocated_amount', 0) + m.amount &&
        after.allocated_amount + before.deposited_amount <= before.received_amount;
    }
    function validHandoverRefund() {
      let after = request.resource.data;
      let m = getAfter(/databases/$(database)/documents/treasuryMovements/$(after.treasury_movement_id)).data;
      return isAdmin() && m.kind == 'EXPENSE_REFUND' && m.destination_fund_id == resource.data.treasury_fund_id &&
        !exists(/databases/$(database)/documents/treasuryMovements/$(m.id)) &&
        after.diff(resource.data).affectedKeys().hasOnly(['allocated_amount', 'treasury_movement_id']) &&
        after.allocated_amount == resource.data.allocated_amount - m.amount && after.allocated_amount >= 0;
    }
    function validHandoverTreasuryDeposit() {
      let before = resource.data;
      let after = request.resource.data;
      let m = getAfter(/databases/$(database)/documents/treasuryMovements/$(after.treasury_movement_id)).data;
      return m.kind == 'DEPOSIT' && m.fund_id == before.treasury_fund_id &&
        m.amount == after.deposited_amount - before.deposited_amount &&
        !exists(/databases/$(database)/documents/treasuryMovements/$(after.treasury_movement_id));
    }
    function validTreasuryPayment() {
      let p = request.resource.data.payments[request.resource.data.payments.size() - 1];
      let m = getAfter(/databases/$(database)/documents/treasuryMovements/$(p.id)).data;
      return m.kind == 'PURCHASE' && m.purchase_id == resource.data.id &&
        m.fund_id == p.treasury_fund_id && m.amount == p.amount &&
        !exists(/databases/$(database)/documents/treasuryMovements/$(p.id));
    }

    match /purchases/{purchaseId} {
      // Receipt transactions read the linked purchase before crediting stock.
      // Keep this document-only access separate from procurement list/manage rights.
      function canReadForReceipt() {
        let transferId = resource.data.get('transfer_id', '');
        let transfer = get(/databases/$(database)/documents/transfers/$(transferId)).data;
        return hasPermission('transfers.receive') &&
          hasStoreAccess(resource.data.store_id) &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.store_id]) &&
          resource.data.status == 'APPROVED' &&
          transfer.type == 'SUPPLIER_TO_STORE' &&
          transfer.purchase_id == purchaseId &&
          transfer.destination_store_id == resource.data.store_id &&
          transfer.status in ['IN_TRANSIT', 'RECEIVED'];
      }

      allow get: if (hasPermission('procurement.manage') &&
        (resource == null || hasStoreAccess(resource.data.store_id))) ||
        (resource != null && canReadForReceipt());
      allow list: if hasPermission('procurement.manage') && hasStoreAccess(resource.data.store_id);
      allow create: if hasPermission('procurement.manage') &&
        request.resource.data.id == purchaseId &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.status == 'DRAFT' &&
        hasStoreAccess(request.resource.data.store_id) &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.is_active == true &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type in ['CENTRAL_WAREHOUSE', 'MANUFACTURER'] &&
        exists(/databases/$(database)/documents/suppliers/$(request.resource.data.supplier_id)) &&
        get(/databases/$(database)/documents/suppliers/$(request.resource.data.supplier_id)).data.is_active == true &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.amount_paid == 0 &&
        request.resource.data.payment_status == 'UNPAID' &&
        request.resource.data.payments is list &&
        request.resource.data.payments.size() == 0;
      allow update: if (
        hasPermission('procurement.manage') &&
        hasStoreAccess(resource.data.store_id) &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'APPROVED' &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.supplier_id == resource.data.supplier_id &&
        request.resource.data.lines == resource.data.lines &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.invoice_number == resource.data.invoice_number &&
        request.resource.data.expected_payment_at == resource.data.expected_payment_at &&
        request.resource.data.payments == resource.data.payments &&
        request.resource.data.amount_paid == resource.data.amount_paid &&
        request.resource.data.approved_by == request.auth.uid &&
        request.resource.data.transfer_id == 'trf-purchase-' + purchaseId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'approved_by', 'approved_by_name', 'approved_at', 'transfer_id', 'updated_at'
        ]) &&
        existsAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)) &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.type == 'SUPPLIER_TO_STORE' &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.purchase_id == purchaseId &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.status == 'IN_TRANSIT' &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.approved_by == request.auth.uid &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.requested_by == resource.data.created_by &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.destination_store_id == resource.data.store_id &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.supplier_id == resource.data.supplier_id
      ) || (
        hasPermission('procurement.manage') &&
        hasStoreAccess(resource.data.store_id) &&
        resource.data.get('status', 'RECEIVED') in ['APPROVED', 'RECEIVED'] &&
        request.resource.data.get('status', 'RECEIVED') == resource.data.get('status', 'RECEIVED') &&
        request.resource.data.payments is list &&
        request.resource.data.payments.size() == resource.data.payments.size() + 1 &&
        request.resource.data.payments.hasAll(resource.data.payments) &&
        ((!isAdmin() && !('treasury_fund_id' in request.resource.data.payments[request.resource.data.payments.size() - 1])) || validTreasuryPayment()) &&
        request.resource.data.payments[request.resource.data.payments.size() - 1].amount is number &&
        request.resource.data.payments[request.resource.data.payments.size() - 1].amount > 0 &&
        request.resource.data.payments[request.resource.data.payments.size() - 1].paid_by == request.auth.uid &&
        request.resource.data.payments[request.resource.data.payments.size() - 1].paid_at is number &&
        request.resource.data.payments[request.resource.data.payments.size() - 1].method in [
          'CASH', 'MVOLA', 'AIRTEL_MONEY', 'ORANGE_MONEY', 'CHECK', 'BANK_TRANSFER'
        ] &&
        request.resource.data.amount_paid is number &&
        request.resource.data.amount_paid ==
          resource.data.amount_paid +
          request.resource.data.payments[request.resource.data.payments.size() - 1].amount &&
        request.resource.data.amount_paid <= resource.data.total &&
        (
          (request.resource.data.amount_paid == resource.data.total &&
            request.resource.data.payment_status == 'PAID') ||
          (request.resource.data.amount_paid < resource.data.total &&
            request.resource.data.payment_status == 'PARTIAL')
        ) &&
        request.resource.data.updated_at == request.resource.data.payments[request.resource.data.payments.size() - 1].paid_at &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount_paid', 'payment_status', 'payments', 'updated_at'
        ])
      ) || (
        isActiveUser() &&
        resource.data.status == 'APPROVED' &&
        request.resource.data.status == 'RECEIVED' &&
        request.resource.data.transfer_id == resource.data.transfer_id &&
        hasStoreAccess(resource.data.store_id) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.store_id]) &&
        request.resource.data.received_by is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'received_by', 'received_by_name', 'received_at', 'updated_at'
        ]) &&
        existsAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)) &&
        getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.status in ['VALIDATED', 'DISCREPANCY'] &&
        getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.purchase_id == purchaseId &&
        getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.received_by == request.resource.data.received_by &&
        (
          (
            get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.validated_by == request.auth.uid &&
            request.resource.data.received_by != request.auth.uid
          ) ||
          (
            get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.store_type != 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid
          )
        )
      );
    }

    function hasExpenseStoreAccess(storeId) {
      return isAdmin() || (isActiveUser() && storeId is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([storeId]));
    }

    function isSalaryAdvanceExpense(data) {
      return data.category == 'SALARY_ADVANCE';
    }

    function hasValidSalaryAdvanceDetails(data) {
      return ('employee_id' in data) &&
        data.employee_id is string &&
        exists(/databases/$(database)/documents/employees/$(data.employee_id)) &&
        ('employee_name' in data) &&
        data.employee_name == get(/databases/$(database)/documents/employees/$(data.employee_id)).data.first_name + ' ' +
          get(/databases/$(database)/documents/employees/$(data.employee_id)).data.last_name &&
        ('salary_advance_id' in data) &&
        data.salary_advance_id == 'advance-' + data.id &&
        data.payment_status == 'PAID' &&
        data.description is string &&
        data.description.size() > 0;
    }

    function hasExpensePaymentFields(data) {
      return data.keys().hasAny(['treasury_fund_id', 'treasury_movement_id', 'paid_by', 'paid_by_name', 'paid_at', 'funding_source', 'payment_recorded_by']);
    }
    function validStoreExpensePayment() {
      let after = request.resource.data;
      let store = get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data;
      return isAdmin() && store.is_active == true && after.funding_source == 'STORE' &&
        after.payment_recorded_by == request.auth.uid && after.paid_by_name == store.name && after.paid_at is number &&
        after.payment_status == 'PAID' && after.status == 'VALIDATED' &&
        !after.keys().hasAny(['treasury_fund_id', 'treasury_movement_id', 'paid_by']);
    }
    function validExpenseCancellation() {
      let before = resource.data;
      let after = request.resource.data;
      return isAdmin() && before.get('status', 'VALIDATED') != 'CANCELLED' && after.status == 'CANCELLED' &&
        after.cancelled_by == request.auth.uid && after.cancelled_by_name is string && after.cancelled_at is number &&
        after.cancellation_reason is string && after.cancellation_reason.size() > 0 &&
        after.diff(before).affectedKeys().hasOnly(['status', 'cancelled_by', 'cancelled_by_name', 'cancelled_at', 'cancellation_reason', 'treasury_reversal_id']) &&
        (!('treasury_movement_id' in before) || (
          !exists(/databases/$(database)/documents/treasuryMovements/$(after.treasury_reversal_id)) &&
          getAfter(/databases/$(database)/documents/treasuryMovements/$(after.treasury_reversal_id)).data.expense_id == before.id &&
          treasuryExpenseRefund(getAfter(/databases/$(database)/documents/treasuryMovements/$(after.treasury_reversal_id)).data))) &&
        (!('salary_advance_id' in before) || !exists(/databases/$(database)/documents/salaryAdvances/$(before.salary_advance_id)) || (
          get(/databases/$(database)/documents/salaryAdvances/$(before.salary_advance_id)).data.status == 'OUTSTANDING' &&
          get(/databases/$(database)/documents/salaryAdvances/$(before.salary_advance_id)).data.get('amount_deducted', 0) == 0 &&
          get(/databases/$(database)/documents/salaryAdvances/$(before.salary_advance_id)).data.get('payslip_id', '') == '' &&
          !existsAfter(/databases/$(database)/documents/salaryAdvances/$(before.salary_advance_id))));
    }
    function validExpenseTreasuryPayment() {
      let after = request.resource.data;
      let m = getAfter(/databases/$(database)/documents/treasuryMovements/$(after.treasury_movement_id)).data;
      let fund = get(/databases/$(database)/documents/treasuryFunds/$(after.treasury_fund_id)).data;
      return isAdmin() && after.paid_by == request.auth.uid && after.paid_by_name == fund.owner_name &&
        after.paid_at is number && after.payment_status == 'PAID' && after.status == 'VALIDATED' &&
        m.kind == 'EXPENSE' && m.expense_id == resource.data.id && m.amount == resource.data.amount &&
        m.fund_id == after.treasury_fund_id && m.created_at == after.paid_at &&
        !exists(/databases/$(database)/documents/treasuryMovements/$(after.treasury_movement_id));
    }

    match /expenses/{expenseId} {
      // Employees may check their own advance source, including a deleted source.
      allow get: if isActiveUser() && (resource == null || isAdmin() || (
        resource.data.get('employee_id', null) != null &&
        get(/databases/$(database)/documents/employees/$(resource.data.employee_id)).data.get('user_id', null) == request.auth.uid
      ));
      allow read: if (hasPermission('expenses.view') || hasPermission('expenses.create')) &&
        (isAdmin() || resource.data.created_by == request.auth.uid || hasExpenseStoreAccess(resource.data.get('store_id', null)));
      // Cash reconciliation requires validated expenses, never draft access.
      allow read: if hasAnyPermission(['cash_handover.view', 'cash_handover.create', 'cash_handover.receive', 'cash_handover.deposit']) &&
        resource.data.status == 'VALIDATED' && hasStoreAccess(resource.data.get('store_id', null));
      allow create: if hasPermission('expenses.create') &&
        hasExpenseStoreAccess(request.resource.data.get('store_id', null)) &&
        request.resource.data.id == expenseId &&
        request.resource.data.status == 'DRAFT' &&
        !exists(/databases/$(database)/documents/treasuryMovements/$('expense-' + expenseId)) &&
        !request.resource.data.keys().hasAny(['cancelled_by', 'cancelled_by_name', 'cancelled_at', 'cancellation_reason', 'treasury_reversal_id']) &&
        !hasExpensePaymentFields(request.resource.data) &&
        !request.resource.data.keys().hasAny(['validated_by', 'validated_at']) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.description is string &&
        (
          (isSalaryAdvanceExpense(request.resource.data) && isAdmin() && hasValidSalaryAdvanceDetails(request.resource.data)) ||
          (!isSalaryAdvanceExpense(request.resource.data) && !request.resource.data.keys().hasAny(['employee_id', 'employee_name', 'salary_advance_id']))
        );
      allow update: if (
        hasPermission('expenses.create') &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        resource.data.created_by == request.auth.uid &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.expense_number == resource.data.expense_number &&
        request.resource.data.created_at == resource.data.created_at &&
        hasExpenseStoreAccess(request.resource.data.get('store_id', null)) &&
        (!isSalaryAdvanceExpense(resource.data) && !isSalaryAdvanceExpense(request.resource.data) || isAdmin()) &&
        (
          (isSalaryAdvanceExpense(request.resource.data) && hasValidSalaryAdvanceDetails(request.resource.data)) ||
          (!isSalaryAdvanceExpense(request.resource.data) && !request.resource.data.keys().hasAny(['employee_id', 'employee_name', 'salary_advance_id']))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'category', 'description', 'amount', 'expense_date', 'store_id',
          'store_name', 'payee', 'employee_id', 'employee_name', 'salary_advance_id',
          'payment_method', 'payment_status', 'reference', 'notes'
        ])
      ) || (
        hasPermission('expenses.create') &&
        (isSuperAdmin() || (resource.data.created_by == request.auth.uid && hasExpenseStoreAccess(resource.data.get('store_id', null)))) &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'VALIDATED' &&
        request.resource.data.validated_by == request.auth.uid &&
        request.resource.data.validated_at is number &&
        (
          !isSalaryAdvanceExpense(resource.data) ||
          (
            isAdmin() &&
            hasValidSalaryAdvanceDetails(resource.data) &&
            existsAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)) &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.id == resource.data.salary_advance_id &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.expense_id == expenseId &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.employee_id == resource.data.employee_id &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.amount == resource.data.amount &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.advance_date == resource.data.expense_date &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.payment_method == resource.data.payment_method &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.reason == resource.data.description &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.status == 'OUTSTANDING'
          )
        ) &&
        ((isAdmin() && resource.data.payment_status == 'PAID' && (validExpenseTreasuryPayment() || validStoreExpensePayment())) ||
          ((!isAdmin() || resource.data.payment_status != 'PAID') && !hasExpensePaymentFields(request.resource.data))) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'validated_by', 'validated_at', 'treasury_fund_id', 'treasury_movement_id', 'paid_by', 'paid_by_name', 'paid_at', 'funding_source', 'payment_recorded_by'
        ])
      );
      allow update: if isAdmin() && resource.data.status == 'VALIDATED' && resource.data.payment_status == 'PENDING' &&
        !hasExpensePaymentFields(resource.data) && (validExpenseTreasuryPayment() || validStoreExpensePayment()) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'payment_status', 'treasury_fund_id', 'treasury_movement_id', 'paid_by', 'paid_by_name', 'paid_at', 'funding_source', 'payment_recorded_by'
        ]);
      allow update: if validExpenseCancellation();
      allow delete: if isSuperAdmin() && resource.data.get('status', 'VALIDATED') in ['DRAFT', 'CANCELLED'] &&
        (!('treasury_movement_id' in resource.data) || ('treasury_reversal_id' in resource.data));
    }

    match /movements/{movementId} {
      allow read: if isActiveUser() && hasStoreAccess(resource.data.store_id);
      allow create: if hasStoreAccess(request.resource.data.store_id) &&
        (!(request.resource.data.get('movement_type', '') == 'CONSUMPTION' || request.resource.data.get('reference_type', '') == 'CONSUMPTION') ||
          (get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type == 'MANUFACTURER' &&
           get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.is_active == true)) &&
        ((request.resource.data.keys().hasAny(['sale_check']) &&
          request.resource.data.movement_type == 'SALE' && request.resource.data.reference_type == 'SALE' &&
          request.resource.data.created_by == request.auth.uid &&
          request.resource.data.get('stock_bucket', '') != 'QUARANTINE' &&
          request.resource.data.after_quantity >= 0 &&
          request.resource.data.after_quantity == request.resource.data.before_quantity + request.resource.data.quantity &&
          canDebitCheckedSale(request.resource.data, request.resource.data.quantity)) ||
          (request.resource.data.keys().hasAny(['transfer_shipment']) &&
          request.resource.data.reference_type == 'TRANSFER' &&
          request.resource.data.reference_id == request.resource.data.transfer_shipment.transfer_id &&
          request.resource.data.created_by == request.auth.uid &&
          request.resource.data.get('stock_bucket', '') != 'QUARANTINE' &&
          request.resource.data.after_quantity >= 0 &&
          request.resource.data.after_quantity == request.resource.data.before_quantity + request.resource.data.quantity &&
          canDebitShipment(request.resource.data, request.resource.data.quantity)) ||
          (request.resource.data.keys().hasAny(['transfer_receipt']) &&
          request.resource.data.reference_type == 'TRANSFER' &&
          request.resource.data.reference_id == request.resource.data.transfer_receipt.transfer_id &&
          request.resource.data.created_by == request.auth.uid &&
          request.resource.data.after_quantity == request.resource.data.before_quantity + request.resource.data.quantity &&
          canCreditPosReceipt(request.resource.data, request.resource.data.quantity)) ||
          (!request.resource.data.keys().hasAny(['sale_check']) && canStoreArticle(request.resource.data.store_id, request.resource.data.article_id))) && (
        hasAnyPermission(['stock.adjust', 'transfers.ship', 'transfers.receive', 'sales.validate', 'production.create', 'production.validate']) ||
        (hasPermission('stock.edit') &&
          request.resource.data.movement_type == 'CONSUMPTION' &&
          request.resource.data.reference_type == 'CONSUMPTION' &&
          request.resource.data.created_by == request.auth.uid &&
          request.resource.data.quantity is number && request.resource.data.quantity < 0 &&
          request.resource.data.after_quantity >= 0 &&
          request.resource.data.after_quantity == request.resource.data.before_quantity + request.resource.data.quantity &&
          get(/databases/$(database)/documents/articles/$(request.resource.data.article_id)).data.article_type == 'RAW_MATERIAL')
      );
    }

    match /sales/{saleId} {
      allow read: if (hasPermission('sales.view') && (resource == null || hasStoreAccess(resource.data.store_id)) || hasPermission('credit.manage'));
      allow create: if hasPermission('sales.create') &&
        request.resource.data.seller_id == request.auth.uid &&
        (request.resource.data.status == 'DRAFT' ||
          (isAdmin() && request.resource.data.status == 'VALIDATED' && request.resource.data.customer_type == 'REVENDEUR')) &&
        request.resource.data.lines is list && request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number && request.resource.data.total >= 0 &&
        request.resource.data.amount_paid is number &&
        request.resource.data.amount_paid >= 0 &&
        hasStoreAccess(request.resource.data.store_id) &&
        (get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type != 'CENTRAL_WAREHOUSE' ||
          (request.resource.data.amount_paid == 0 && request.resource.data.get('credit_payments', []).size() == 0) ||
          validInitialResellerPayment(request.resource.data)) &&
        (
          request.resource.data.customer_type != 'REVENDEUR' ||
          (
            (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'RESPONSABLE_MAGASIN') &&
            exists(/databases/$(database)/documents/stores/$(request.resource.data.store_id)) &&
            get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            (
              (isAdmin() && request.resource.data.status == 'VALIDATED') ||
              (
                request.resource.data.credit_customer_id is string &&
                exists(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)) &&
                get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.is_active == true
              )
            ) &&
            (
              (isAdmin() && request.resource.data.status == 'VALIDATED' && !request.resource.data.keys().hasAny(['credit_customer_id'])) ||
              request.resource.data.amount_paid >= request.resource.data.total ||
              (
                hasPermission('credit.sales') &&
                request.resource.data.credit_customer_id is string &&
                exists(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)) &&
                get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.is_active == true &&
                request.resource.data.credit_due_at is number &&
                existsAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)) &&
                getAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.outstanding_balance ==
                  get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.outstanding_balance +
                  request.resource.data.total - request.resource.data.amount_paid &&
                getAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.outstanding_balance <=
                  get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.credit_limit &&
                getAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.last_credit_sale_id == saleId
              )
            )
          )
        );
      allow update: if (
        hasPermission('sales.create') &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        resource.data.seller_id == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.sale_number == resource.data.sale_number &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.seller_id == resource.data.seller_id &&
        request.resource.data.seller_name == resource.data.seller_name &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.customer_type == resource.data.customer_type &&
        request.resource.data.get('credit_customer_id', null) == resource.data.get('credit_customer_id', null) &&
        request.resource.data.amount_paid == resource.data.amount_paid &&
        request.resource.data.payment_method == resource.data.payment_method &&
        request.resource.data.get('credit_payments', []) == resource.data.get('credit_payments', []) &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customer_name', 'customer_phone', 'credit_due_at', 'lines', 'subtotal',
          'discount', 'tax', 'total', 'payment_status', 'change_returned', 'notes'
        ]) &&
        (
          !resource.data.keys().hasAny(['credit_customer_id']) ||
          (
            existsAfter(/databases/$(database)/documents/creditCustomers/$(resource.data.credit_customer_id)) &&
            getAfter(/databases/$(database)/documents/creditCustomers/$(resource.data.credit_customer_id)).data.outstanding_balance ==
              get(/databases/$(database)/documents/creditCustomers/$(resource.data.credit_customer_id)).data.outstanding_balance +
              request.resource.data.total - request.resource.data.amount_paid -
              resource.data.total + resource.data.amount_paid
          )
        ) &&
        hasStoreAccess(resource.data.store_id)
      ) || (
        (hasPermission('sales.edit') || hasPermission('sales.validate')) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.seller_id == resource.data.seller_id &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.customer_type == resource.data.customer_type &&
        request.resource.data.lines == resource.data.lines &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.discount == resource.data.discount &&
        request.resource.data.tax == resource.data.tax &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.amount_paid == resource.data.amount_paid &&
        request.resource.data.payment_method == resource.data.payment_method &&
        request.resource.data.get('credit_payments', []) == resource.data.get('credit_payments', []) &&
        (
          (resource.data.status == 'DRAFT' && request.resource.data.status == 'CHECKING') ||
          (resource.data.status == 'DRAFT' && request.resource.data.status == 'CANCELLED' && isSuperAdmin()) ||
          (resource.data.status == 'CHECKING' && request.resource.data.status == 'VERIFIED') ||
          (resource.data.status == 'CHECKING' && request.resource.data.status == 'CANCELLED' && isSuperAdmin()) ||
          (resource.data.status == 'VERIFIED' && request.resource.data.status == 'CANCELLED' && isSuperAdmin()) ||
          (resource.data.status == 'VALIDATED' && request.resource.data.status == 'CANCELLED' && isSuperAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
          (resource.data.status == 'VERIFIED' && request.resource.data.status == 'VALIDATED' && resource.data.customer_type != 'REVENDEUR') ||
          (
            resource.data.status == 'VERIFIED' && request.resource.data.status == 'APPROVED' &&
            resource.data.customer_type == 'REVENDEUR' && isAdmin() &&
            request.resource.data.approved_by == request.auth.uid &&
            request.resource.data.approved_at is number
          ) ||
          (
            resource.data.status == 'APPROVED' && request.resource.data.status == 'CANCELLED' &&
            isSuperAdmin()
          ) ||
          (
            resource.data.status == 'APPROVED' && request.resource.data.status == 'VALIDATED' &&
            resource.data.customer_type == 'REVENDEUR' && hasPermission('sales.validate') &&
            hasStoreAccess(resource.data.store_id) &&
            request.resource.data.get('approved_by', null) == resource.data.get('approved_by', null)
          )
        ) &&
        (request.resource.data.status != 'VALIDATED' || request.resource.data.validated_by == request.auth.uid)
      ) || (
        canCollectReseller(resource.data.store_id) &&
        // Each branch restricts all changed fields. Reading optional legacy
        // seller metadata here would reject an otherwise valid payment.
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'amount_paid', 'payment_status', 'credit_payments'
            ]) &&
            validResellerPayment(resource.data, request.resource.data) &&
            request.resource.data.amount_paid > resource.data.amount_paid &&
            request.resource.data.amount_paid <= resource.data.total &&
            request.resource.data.payment_status == (request.resource.data.amount_paid == resource.data.total ? 'PAID' : 'PARTIAL')
          ) ||
          (
            hasPermission('credit.manage') &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credit_followups']) &&
            request.resource.data.credit_followups.size() == resource.data.get('credit_followups', []).size() + 1
          )
        )
      ) || (
        isAdmin() &&
        resource.data.status == 'VALIDATED' &&
        resource.data.payment_status != 'PAID' &&
        !resource.data.keys().hasAny(['credit_customer_id']) &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.amount_paid == resource.data.total &&
        request.resource.data.payment_status == 'PAID' &&
        validResellerPayment(resource.data, request.resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount_paid', 'payment_status', 'credit_payments'])
      );
      allow delete: if isSuperAdmin() &&
        resource.data.status in ['DRAFT', 'CANCELLED'];
    }

    match /productions/{productionId} {
      allow read: if hasPermission('production.view') && (resource == null || hasStoreAccess(resource.data.manufacturer_store_id));
      allow create: if (hasPermission('production.create') || hasPermission('production.validate')) &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.consumptions is list && request.resource.data.consumptions.size() > 0 &&
        request.resource.data.outputs is list && request.resource.data.outputs.size() > 0 &&
        hasStoreAccess(request.resource.data.manufacturer_store_id);
      allow update: if hasPermission('production.validate') &&
        hasStoreAccess(resource.data.manufacturer_store_id) &&
        resource.data.status == 'DRAFT' && request.resource.data.status == 'COMPLETED' &&
        request.resource.data.validated_by == request.auth.uid &&
        request.resource.data.validated_at is number &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'validated_by', 'validated_by_name', 'validated_at']);
      allow update: if hasPermission('production.create') &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        resource.data.created_by == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.production_number == resource.data.production_number &&
        request.resource.data.manufacturer_store_id == resource.data.manufacturer_store_id &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.consumptions is list &&
        request.resource.data.consumptions.size() > 0 &&
        request.resource.data.outputs is list &&
        request.resource.data.outputs.size() > 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumptions', 'outputs', 'notes']) &&
        hasStoreAccess(resource.data.manufacturer_store_id);
      allow delete: if isSuperAdmin() && resource.data.status == 'DRAFT';
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin() || (
        isActiveUser() && resource.data.user_id == request.auth.uid
      );
      allow create: if isActiveUser() && request.resource.data.user_id == request.auth.uid;
    }

    // Inventory master data. Administrators seed and maintain stores; active
    // users may read inventory, while stock adjustments require stock.adjust.
    match /stores/{storeId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }


    function canControlPresentation() {
      return isAdmin() || (isActiveUser() && (
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['CONTROLEUR', 'RESPONSABLE_MAGASIN'] ||
        hasPermission('employee_presentation.control')));
    }
    match /employeeDirectory/{employeeId} {
      allow read: if canControlPresentation() && hasStoreAccess(resource.data.store_id);
      allow create, update: if isAdmin() && request.resource.data.keys().hasOnly(['id', 'first_name', 'last_name', 'position', 'store_id', 'is_active']) && request.resource.data.id == employeeId;
      allow delete: if isAdmin();
    }
    match /employeePresentationChecks/{checkId} {
      function validFinding(f, submitted) {
        return f.keys().hasOnly(['result', 'note', 'photo']) &&
          f.result in ['OK', 'ISSUE', 'NA'] && f.note is string && f.note.size() <= 4000 &&
          f.photo is string && f.photo.size() <= 2000 && (f.photo == '' || f.photo.matches('https://.*')) &&
          (!submitted || f.result != 'ISSUE' || f.note.size() >= 5);
      }
      function validCheck() {
        let d = request.resource.data;
        let submitted = d.status != 'DRAFT';
        return d.keys().hasOnly(['id', 'store_id', 'employee_id', 'employee_name', 'created_by', 'created_by_name', 'created_at', 'updated_at', 'status', 'findings', 'review_note', 'reviewed_by', 'reviewed_at']) &&
          d.id == checkId && d.status in ['DRAFT', 'SUBMITTED', 'VALIDATED', 'CORRECTION'] &&
          d.findings is list && d.findings.size() == 4 &&
          validFinding(d.findings[0], submitted) && validFinding(d.findings[1], submitted) &&
          validFinding(d.findings[2], submitted) && validFinding(d.findings[3], submitted) &&
          (!submitted || d.findings[0].result != 'NA' || d.findings[1].result != 'NA' || d.findings[2].result != 'NA' || d.findings[3].result != 'NA') &&
          d.review_note is string && d.review_note.size() <= 4000 &&
          d.created_by_name is string && d.employee_name is string && d.created_at is number && d.updated_at is number;
      }
      function validEmployee() {
        let d = request.resource.data;
        let e = get(/databases/$(database)/documents/employees/$(d.employee_id)).data;
        return e.is_active == true && e.get('linked_archive_id', '') == '' && e.store_id == d.store_id &&
          d.employee_name == e.first_name + ' ' + e.last_name;
      }
      allow read: if canControlPresentation() && hasStoreAccess(resource.data.store_id);
      allow create: if canControlPresentation() && validCheck() && validEmployee() &&
        hasStoreAccess(request.resource.data.store_id) && request.resource.data.created_by == request.auth.uid &&
        request.resource.data.status in ['DRAFT', 'SUBMITTED'] && request.resource.data.reviewed_by == '' && request.resource.data.reviewed_at == 0 && request.resource.data.review_note == '';
      allow update: if validCheck() && (
        (canControlPresentation() && hasStoreAccess(resource.data.store_id) && validEmployee() &&
          resource.data.created_by == request.auth.uid && resource.data.status in ['DRAFT', 'CORRECTION'] &&
          request.resource.data.status in ['DRAFT', 'SUBMITTED'] && request.resource.data.reviewed_by == '' && request.resource.data.reviewed_at == 0 && request.resource.data.review_note == '' &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'findings', 'updated_at', 'review_note', 'reviewed_by', 'reviewed_at'])) ||
        (isAdmin() && resource.data.status == 'SUBMITTED' && resource.data.created_by != request.auth.uid &&
          request.resource.data.status in ['VALIDATED', 'CORRECTION'] && request.resource.data.reviewed_by == request.auth.uid && request.resource.data.reviewed_at is number &&
          (request.resource.data.status != 'CORRECTION' || request.resource.data.review_note.size() > 0) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updated_at', 'review_note', 'reviewed_by', 'reviewed_at']))
      );
      allow delete: if false;
    }

    match /inventoryCounts/{countId} {
      function isCounter() {
        return isActiveUser() && (
          isAdmin() ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['RESPONSABLE_MAGASIN', 'CONTROLEUR'] ||
          hasPermission('inventory.count')
        );
      }

      function validEmployeeCharge(data) {
        let employeeId = data.charged_employee_id;
        let employee = get(/databases/$(database)/documents/employees/$(employeeId)).data;
        let linkedUser = employee.get('user_id', '');
        return isSuperAdmin() && data.get('total_charged_amount', 0) > 0 &&
          data.charged_to_name == employee.first_name + ' ' + employee.last_name &&
          data.charged_to == (linkedUser is string && linkedUser.size() > 0 ? linkedUser : employeeId) &&
          data.charge_assigned_by == request.auth.uid && data.charge_assigned_at is number;
      }

      function validChargeAssignment() {
        let data = request.resource.data;
        return data.get('charged_employee_id', null) is string
          ? validEmployeeCharge(data)
          : (!data.keys().hasAny(['charged_employee_id', 'charge_assigned_by', 'charge_assigned_by_name', 'charge_assigned_at']) &&
            (data.get('total_charged_amount', 0) <= 0 ||
              (data.charged_to == resource.data.get('manager_signed_by', resource.data.created_by) &&
               data.charged_to_name == resource.data.get('manager_signed_by_name', resource.data.created_by_name))));
      }

      function payrollEmployeeMatches(employeeId) {
        let employee = get(/databases/$(database)/documents/employees/$(employeeId)).data;
        let responsible = resource.data.get('charged_to', resource.data.get('manager_signed_by', resource.data.created_by));
        return resource.data.get('charged_employee_id', null) is string
          ? resource.data.charged_employee_id == employeeId
          : responsible == employeeId || (employee.get('user_id', '') != '' && employee.get('user_id', '') == responsible);
      }

      function linkedPayroll(settlement) {
        let payroll = getAfter(/databases/$(database)/documents/payroll/$(settlement.payslip_id)).data;
        return settlement.payslip_id is string && payroll.inventory_count_ids.hasAny([countId]) &&
          payroll.inventory_charges_deducted >= resource.data.total_charged_amount &&
          payrollEmployeeMatches(payroll.employee_id);
      }

      allow read: if isAdmin() || (isActiveUser() && (hasStoreAccess(resource.data.store_id) || resource.data.get('charged_to', null) == request.auth.uid ||
        (resource.data.get('charged_employee_id', null) is string &&
          get(/databases/$(database)/documents/employees/$(resource.data.charged_employee_id)).data.get('user_id', null) == request.auth.uid)));
      allow create: if isCounter() &&
        request.resource.data.id == countId &&
        request.resource.data.created_by == request.auth.uid &&
        (isAdmin() || hasStoreAccess(request.resource.data.store_id)) &&
        request.resource.data.status in ['DRAFT', 'AWAITING_SIGNATURE', 'SUBMITTED'] &&
        (request.resource.data.status == 'DRAFT' || (request.resource.data.status == 'AWAITING_SIGNATURE' && request.resource.data.manager_id is string) || (request.resource.data.status == 'SUBMITTED' && request.resource.data.get('signature_waived', false) == true && !('manager_signed_at' in request.resource.data)));
      allow update: if (
        isCounter() &&
        resource.data.status == 'DRAFT' &&
        resource.data.created_by == request.auth.uid &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.status in ['DRAFT', 'AWAITING_SIGNATURE', 'SUBMITTED'] &&
        (request.resource.data.status == 'DRAFT' || (request.resource.data.status == 'AWAITING_SIGNATURE' && request.resource.data.manager_id is string) || (request.resource.data.status == 'SUBMITTED' && request.resource.data.get('signature_waived', false) == true && !('manager_signed_at' in request.resource.data)))
      ) || (
        // Le responsable désigné signe (présence attestée) ou refuse de signer.
        isActiveUser() && resource.data.status == 'AWAITING_SIGNATURE' &&
        resource.data.manager_id == request.auth.uid &&
        request.resource.data.status in ['SUBMITTED', 'REJECTED'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'manager_signed_at', 'manager_signed_by', 'manager_signed_by_name', 'submitted_at',
          'reviewed_by', 'reviewed_by_name', 'reviewed_at', 'review_note', 'updated_at'
        ]) &&
        (request.resource.data.status == 'REJECTED' || request.resource.data.manager_signed_by == request.auth.uid)
      ) || (
        isAdmin() && resource.data.status == 'SUBMITTED' &&
        resource.data.created_by != request.auth.uid &&
        ('manager_signed_at' in resource.data || resource.data.get('signature_waived', false) == true) &&
        request.resource.data.status in ['VALIDATED', 'REJECTED'] &&
        request.resource.data.store_id == resource.data.store_id &&
        (request.resource.data.status != 'VALIDATED' ||
          (request.resource.data.reviewed_by == request.auth.uid && request.resource.data.reviewed_at is number && validChargeAssignment()))
      ) || (
        isAdmin() && resource.data.status == 'VALIDATED' &&
        !('charge_settlement' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['charge_settlement', 'updated_at']) &&
        request.resource.data.charge_settlement.settled_by == request.auth.uid &&
        request.resource.data.charge_settlement.settled_at is number &&
        request.resource.data.charge_settlement.reference is string &&
        request.resource.data.charge_settlement.reference.size() > 0 &&
        request.resource.data.charge_settlement.method in ['PAYSLIP', 'ADVANCE', 'OTHER'] &&
        (request.resource.data.charge_settlement.method != 'PAYSLIP' || linkedPayroll(request.resource.data.charge_settlement))
      );
      allow delete: if isCounter() && resource.data.status == 'DRAFT' && resource.data.created_by == request.auth.uid;
    }

    match /creditCustomers/{customerId} {
      allow update: if isActiveUser() && currentProfile().get('role', '') == 'RESPONSABLE_MAGASIN' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'updated_at', 'last_payment_sale_id']) &&
        request.resource.data.last_payment_sale_id is string &&
        canCollectReseller(get(/databases/$(database)/documents/sales/$(request.resource.data.last_payment_sale_id)).data.store_id) &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_payment_sale_id)).data.credit_customer_id == customerId &&
        validResellerPayment(get(/databases/$(database)/documents/sales/$(request.resource.data.last_payment_sale_id)).data,
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_payment_sale_id)).data) &&
        request.resource.data.outstanding_balance >= 0 &&
        resource.data.outstanding_balance - request.resource.data.outstanding_balance ==
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_payment_sale_id)).data.amount_paid -
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_payment_sale_id)).data.amount_paid;
      allow read: if hasPermission('credit.sales') || hasPermission('credit.manage') ||
        (isActiveUser() && resource.data.linked_user_id == request.auth.uid);
      allow create: if hasPermission('credit.manage') &&
        request.resource.data.id == customerId &&
        request.resource.data.credit_limit is number &&
        request.resource.data.credit_limit >= 0 &&
        request.resource.data.outstanding_balance == 0 &&
        request.resource.data.payment_term_days is int &&
        request.resource.data.payment_term_days > 0;
      allow update: if (
        hasPermission('credit.manage') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.credit_limit is number &&
        request.resource.data.credit_limit >= request.resource.data.outstanding_balance &&
        request.resource.data.payment_term_days is int &&
        request.resource.data.payment_term_days > 0
      ) || (
        hasPermission('credit.sales') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'outstanding_balance', 'last_credit_sale_id', 'updated_at'
        ]) &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.outstanding_balance <= resource.data.credit_limit &&
        request.resource.data.last_credit_sale_id is string &&
        exists(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.status == 'DRAFT' &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.status == 'DRAFT' &&
        request.resource.data.outstanding_balance - resource.data.outstanding_balance ==
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total -
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid -
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total +
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid
      ) || (
        hasPermission('credit.sales') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'updated_at']) &&
        request.resource.data.outstanding_balance < resource.data.outstanding_balance &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.last_credit_sale_id is string &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.status == 'CANCELLED' &&
        resource.data.outstanding_balance - request.resource.data.outstanding_balance ==
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total -
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid
      ) || (
        hasPermission('credit.sales') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'last_credit_sale_id', 'updated_at']) &&
        request.resource.data.outstanding_balance > resource.data.outstanding_balance &&
        request.resource.data.outstanding_balance <= resource.data.credit_limit &&
        request.resource.data.last_credit_sale_id is string &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total -
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid ==
          request.resource.data.outstanding_balance - resource.data.outstanding_balance
      ) || (
        isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'last_credit_sale_id', 'last_cancelled_credit_sale_id', 'updated_at'
        ]) &&
        request.resource.data.outstanding_balance == resource.data.outstanding_balance &&
        (
          (
            resource.data.last_credit_sale_id is string &&
            exists(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)) &&
            !existsAfter(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)) &&
            get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.status == 'CANCELLED' &&
            get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
            !request.resource.data.keys().hasAny(['last_credit_sale_id']) &&
            (
              resource.data.get('last_cancelled_credit_sale_id', null) != resource.data.last_credit_sale_id ||
              !request.resource.data.keys().hasAny(['last_cancelled_credit_sale_id'])
            ) &&
            (
              !request.resource.data.keys().hasAny(['last_cancelled_credit_sale_id']) ||
              request.resource.data.last_cancelled_credit_sale_id == resource.data.get('last_cancelled_credit_sale_id', null)
            )
          ) ||
          (
            resource.data.last_cancelled_credit_sale_id is string &&
            exists(/databases/$(database)/documents/sales/$(resource.data.last_cancelled_credit_sale_id)) &&
            !existsAfter(/databases/$(database)/documents/sales/$(resource.data.last_cancelled_credit_sale_id)) &&
            get(/databases/$(database)/documents/sales/$(resource.data.last_cancelled_credit_sale_id)).data.status == 'CANCELLED' &&
            get(/databases/$(database)/documents/sales/$(resource.data.last_cancelled_credit_sale_id)).data.credit_customer_id == customerId &&
            !request.resource.data.keys().hasAny(['last_cancelled_credit_sale_id']) &&
            (
              resource.data.get('last_credit_sale_id', null) != resource.data.last_cancelled_credit_sale_id ||
              !request.resource.data.keys().hasAny(['last_credit_sale_id'])
            ) &&
            (
              !request.resource.data.keys().hasAny(['last_credit_sale_id']) ||
              request.resource.data.last_credit_sale_id == resource.data.get('last_credit_sale_id', null)
            )
          )
        )
      ) || (
        isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'last_cancelled_credit_sale_id', 'updated_at']) &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.last_cancelled_credit_sale_id is string &&
        exists(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)) &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)) &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.credit_customer_id == customerId &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.status == 'VALIDATED' &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.status == 'CANCELLED' &&
        resource.data.outstanding_balance - request.resource.data.outstanding_balance ==
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.total -
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.amount_paid
      ) || (
        isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'updated_at']) &&
        request.resource.data.outstanding_balance >= 0 &&
        resource.data.last_credit_sale_id is string &&
        exists(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)) &&
        get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.status == 'DRAFT' &&
        !existsAfter(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)) &&
        resource.data.outstanding_balance - request.resource.data.outstanding_balance ==
          get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.total -
          get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.amount_paid
      );
      allow delete: if hasPermission('credit.manage') && resource.data.outstanding_balance == 0;
    }

    match /resellerOrders/{orderId} {
      allow read: if isAdmin() ||
        (isActiveUser() && resource.data.reseller_user_id == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'REVENDEUR');
      allow create: if isActiveUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'REVENDEUR' &&
        request.resource.data.id == orderId &&
        request.resource.data.reseller_user_id == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.lines is list && request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number && request.resource.data.total > 0 &&
        request.resource.data.business_name is string &&
        request.resource.data.customer_phone is string &&
        request.resource.data.created_at is number &&
        request.resource.data.payment_type in ['CASH', 'CREDIT'] &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.is_active == true;
      allow update: if isAdmin() &&
        request.resource.data.reseller_user_id == resource.data.reseller_user_id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.payment_type == resource.data.payment_type &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status in ['APPROVED', 'REJECTED', 'REVISION_REQUESTED'] &&
        (
          (request.resource.data.status == 'APPROVED' &&
            request.resource.data.lines is list &&
            request.resource.data.total is number &&
            request.resource.data.sale_id is string) ||
          (request.resource.data.status != 'APPROVED' &&
            request.resource.data.lines == resource.data.lines &&
            request.resource.data.total == resource.data.total)
        ) ||
        (
          isAdmin() &&
          resource.data.status == 'APPROVED' &&
          resource.data.payment_type == 'CASH' &&
          !resource.data.keys().hasAny(['cash_paid_at']) &&
          request.resource.data.status == 'APPROVED' &&
          request.resource.data.payment_type == 'CASH' &&
          request.resource.data.cash_paid_at is number &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'cash_paid_at', 'cash_paid_by', 'cash_paid_by_name', 'updated_at'
          ])
        ) ||
        (
          isActiveUser() &&
          resource.data.reseller_user_id == request.auth.uid &&
          resource.data.status == 'REVISION_REQUESTED' &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.reseller_user_id == resource.data.reseller_user_id &&
          request.resource.data.order_number == resource.data.order_number &&
          request.resource.data.business_name == resource.data.business_name &&
          request.resource.data.customer_name == resource.data.customer_name &&
          request.resource.data.customer_phone == resource.data.customer_phone &&
          request.resource.data.store_id == resource.data.store_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lines', 'total', 'payment_type', 'notes', 'status', 'updated_at', 'admin_message', 'reviewed_by', 'reviewed_by_name', 'reviewed_at'
          ])
        );
      allow delete: if false;
    }

    match /resellerNotifications/{notificationId} {
      allow read: if isActiveUser() && resource.data.user_id == request.auth.uid;
      allow create: if isAdmin() &&
        request.resource.data.user_id is string &&
        request.resource.data.order_id is string &&
        request.resource.data.is_read == false &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.user_id)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.role == 'REVENDEUR';
      allow update: if isActiveUser() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']) &&
        request.resource.data.is_read == true;
      allow delete: if false;
    }

    match /stocks/{stockId} {
      // resource == null lets transactions probe a stock row that does not exist yet (first receipt of an article in a store)
      allow read: if isActiveUser() && (
        resource == null ||
        hasStoreAccess(resource.data.store_id) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'REVENDEUR' &&
          exists(/databases/$(database)/documents/stores/$(resource.data.store_id)) &&
          get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
          exists(/databases/$(database)/documents/articles/$(resource.data.article_id)) &&
          get(/databases/$(database)/documents/articles/$(resource.data.article_id)).data.article_type == 'RESALE'
        )
      );
      allow create: if hasStoreAccess(request.resource.data.store_id) &&
        ((request.resource.data.keys().hasAny(['transfer_receipt']) &&
          request.resource.data.get('quarantine_quantity', 0) == 0 &&
          request.resource.data.reserved_quantity == 0 &&
          canCreditPosReceipt(request.resource.data, request.resource.data.quantity)) ||
          canStoreArticle(request.resource.data.store_id, request.resource.data.article_id)) &&
        request.resource.data.quantity is number && request.resource.data.quantity >= 0 && (
          hasAnyPermission(['stock.adjust', 'transfers.ship', 'transfers.receive', 'sales.validate', 'production.create', 'production.validate']) ||
          isSuperAdmin()
        );
      allow update: if hasStoreAccess(resource.data.store_id) &&
        ((request.resource.data.keys().hasAny(['sale_check']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updated_at', 'sale_check', 'transfer_receipt', 'transfer_shipment']) &&
          canDebitCheckedSale(request.resource.data, request.resource.data.quantity - resource.data.quantity)) ||
          (request.resource.data.keys().hasAny(['transfer_shipment']) &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updated_at', 'transfer_shipment', 'transfer_receipt']) &&
          canDebitShipment(request.resource.data, request.resource.data.quantity - resource.data.quantity)) ||
          (request.resource.data.keys().hasAny(['transfer_receipt']) &&
          request.resource.data.get('quarantine_quantity', 0) == resource.data.get('quarantine_quantity', 0) &&
          request.resource.data.reserved_quantity == resource.data.reserved_quantity &&
          canCreditPosReceipt(request.resource.data, request.resource.data.quantity - resource.data.quantity)) ||
          ((!request.resource.data.keys().hasAny(['sale_check']) || request.resource.data.sale_check == resource.data.get('sale_check', null)) && canStoreArticle(resource.data.store_id, resource.data.article_id))) &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.article_id == resource.data.article_id &&
        request.resource.data.quantity is number && request.resource.data.quantity >= 0 && (
          hasAnyPermission(['stock.adjust', 'transfers.ship', 'transfers.receive', 'sales.validate', 'production.create', 'production.validate']) ||
          (hasPermission('stock.edit') &&
            get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.store_type == 'MANUFACTURER' &&
            request.resource.data.quantity < resource.data.quantity &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['quantity', 'updated_at']) &&
            get(/databases/$(database)/documents/articles/$(resource.data.article_id)).data.article_type == 'RAW_MATERIAL') ||
          isSuperAdmin()
        );
      allow delete: if isAdmin();
    }

    match /transfers/{transferId} {
      // Production exchanges only with another production site or an active depot.
      function productionDestinationAllowed(data) {
        let source = exists(/databases/$(database)/documents/stores/$(data.source_store_id))
          ? get(/databases/$(database)/documents/stores/$(data.source_store_id)).data : {};
        let destination = exists(/databases/$(database)/documents/stores/$(data.destination_store_id))
          ? get(/databases/$(database)/documents/stores/$(data.destination_store_id)).data : {};
        return source.get('store_type', '') == 'MANUFACTURER'
          ? (destination.get('store_type', '') in ['MANUFACTURER', 'CENTRAL_WAREHOUSE'] && destination.get('is_active', false))
          : (destination.get('store_type', '') != 'MANUFACTURER' || source.get('store_type', '') == 'CENTRAL_WAREHOUSE');
      }
      allow get: if isActiveUser() && (
        resource == null
          ? (hasPermission('procurement.manage') || hasPermission('transfers.create'))
          : (hasStoreAccess(resource.data.source_store_id) || hasStoreAccess(resource.data.destination_store_id))
      );
      allow list: if isActiveUser() && (
        hasStoreAccess(resource.data.source_store_id) || hasStoreAccess(resource.data.destination_store_id)
      );
      allow create: if (hasPermission('transfers.create') &&
        request.resource.data.id == transferId &&
        request.resource.data.type == 'DIRECT_DEPOSIT' &&
        request.resource.data.requested_by == request.auth.uid &&
        request.resource.data.source_store_id == request.resource.data.destination_store_id &&
        hasStoreAccess(request.resource.data.destination_store_id) &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0) || (hasPermission('transfers.create') &&
        request.resource.data.id == transferId &&
        request.resource.data.requested_by == request.auth.uid &&
        hasStoreAccess(request.resource.data.source_store_id) &&
        productionDestinationAllowed(request.resource.data) &&
        request.resource.data.source_store_id != request.resource.data.destination_store_id &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)).data.is_active == true &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0) || (
        hasPermission('procurement.manage') &&
        request.resource.data.id == transferId &&
        request.resource.data.type == 'SUPPLIER_TO_STORE' &&
        request.resource.data.status == 'IN_TRANSIT' &&
        request.resource.data.purchase_id is string &&
        request.resource.data.purchase_number is string &&
        request.resource.data.supplier_id is string &&
        request.resource.data.source_store_id == 'supplier-' + request.resource.data.supplier_id &&
        request.resource.data.approved_by == request.auth.uid &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 &&
        hasStoreAccess(request.resource.data.destination_store_id) &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
        request.resource.data.destination_store_id is string &&
        existsAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)) &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.status == 'APPROVED' &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.transfer_id == transferId &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.store_id == request.resource.data.destination_store_id &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.supplier_id == request.resource.data.supplier_id &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.supplier_name == request.resource.data.supplier_name &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.purchase_number == request.resource.data.purchase_number &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.created_by == request.resource.data.requested_by
      );
      allow update: if
        (request.resource.data.status == 'CANCELLED' || productionDestinationAllowed(request.resource.data)) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.created_at == resource.data.created_at &&
        (
          (
            isSuperAdmin() &&
            resource.data.status in ['DRAFT', 'APPROVED', 'SHIPPED', 'IN_TRANSIT', 'RECEIVED', 'VALIDATED', 'DISCREPANCY'] &&
            request.resource.data.status == 'CANCELLED' &&
            !('purchase_id' in resource.data) &&
            request.resource.data.cancelled_by == request.auth.uid &&
            request.resource.data.cancelled_at is number &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'cancelled_by', 'cancelled_by_name', 'cancelled_at', 'updated_at'
            ])
          ) ||
          (
          resource.data.status == 'DRAFT' &&
          request.resource.data.status == 'DRAFT' &&
          hasPermission('transfers.create') &&
          resource.data.requested_by == request.auth.uid &&
          request.resource.data.requested_by == resource.data.requested_by &&
          request.resource.data.requested_by_name == resource.data.requested_by_name &&
          (
            request.resource.data.source_store_id != request.resource.data.destination_store_id ||
            (
              resource.data.type == 'DIRECT_DEPOSIT' &&
              request.resource.data.type == 'DIRECT_DEPOSIT' &&
              get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE'
            )
          ) &&
          hasStoreAccess(request.resource.data.source_store_id) &&
          exists(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)) &&
          get(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)).data.is_active == true &&
          exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
          get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
          request.resource.data.lines is list &&
          request.resource.data.lines.size() > 0 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type', 'source_store_id', 'destination_store_id', 'lines', 'note', 'updated_at'
          ])
        ) ||
        (
          (
            resource.data.status == 'DRAFT' &&
            request.resource.data.status == 'APPROVED' &&
            (
              (isAdmin() && resource.data.requested_by != request.auth.uid) ||
              (
                hasPermission('transfers.create') && hasPermission('transfers.ship') &&
                isActiveUser() &&
                get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.source_store_id]) &&
                resource.data.source_store_id != resource.data.destination_store_id &&
                resource.data.type in ['MANUFACTURER_TO_STORE', 'STORE_TO_STORE'] &&
                !('purchase_id' in resource.data) &&
                get(/databases/$(database)/documents/stores/$(resource.data.source_store_id)).data.store_type == 'MANUFACTURER' &&
                get(/databases/$(database)/documents/stores/$(resource.data.source_store_id)).data.is_active == true &&
                get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type == 'MANUFACTURER' &&
                get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.is_active == true
              )
            ) &&
            request.resource.data.approved_by == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'approved_by', 'approved_by_name', 'approved_at', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'DRAFT' &&
            request.resource.data.status == 'REJECTED' &&
            isAdmin() &&
            resource.data.requested_by != request.auth.uid &&
            request.resource.data.rejected_by == request.auth.uid &&
            request.resource.data.rejection_note is string &&
            request.resource.data.rejection_note.size() > 0 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'rejected_by', 'rejected_by_name', 'rejected_at', 'rejection_note', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'APPROVED' &&
            request.resource.data.status == 'IN_TRANSIT' &&
            hasPermission('transfers.ship') &&
            hasStoreAccess(resource.data.source_store_id) &&
            request.resource.data.shipped_by == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'shipped_by', 'shipped_by_name', 'shipped_at', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'IN_TRANSIT' &&
            request.resource.data.status == 'RECEIVED' &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid &&
            request.auth.uid != resource.data.requested_by &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.lines is list &&
            request.resource.data.has_discrepancy is bool &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lines', 'received_by', 'received_by_name', 'received_at',
              'has_discrepancy', 'note', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'RECEIVED' &&
            request.resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            resource.data.received_by is string &&
            request.resource.data.received_by == resource.data.received_by &&
            request.auth.uid != resource.data.received_by &&
            request.auth.uid != resource.data.requested_by &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.validated_by == request.auth.uid &&
            request.resource.data.lines == resource.data.lines &&
            (
              resource.data.type != 'SUPPLIER_TO_STORE' ||
              (
                resource.data.purchase_id is string &&
                existsAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)) &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.status == 'RECEIVED' &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.received_by == resource.data.received_by
              )
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'validated_by', 'validated_by_name', 'validated_at', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'IN_TRANSIT' &&
            request.resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type != 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid &&
            request.resource.data.validated_by == request.auth.uid &&
            request.auth.uid != resource.data.requested_by &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.lines is list &&
            (
              resource.data.type != 'SUPPLIER_TO_STORE' ||
              (
                resource.data.purchase_id is string &&
                existsAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)) &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.status == 'RECEIVED' &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.received_by == request.auth.uid
              )
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lines', 'received_by', 'received_by_name', 'received_at',
              'validated_by', 'validated_by_name', 'validated_at', 'has_discrepancy',
              'note', 'updated_at'
            ])
          ) ||
          (
            resource.data.type == 'DIRECT_DEPOSIT' &&
            resource.data.status == 'APPROVED' &&
            request.resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid &&
            request.resource.data.validated_by == request.auth.uid &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.lines is list &&
            request.resource.data.lines.size() == resource.data.lines.size() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lines', 'received_by', 'received_by_name', 'received_at',
              'validated_by', 'validated_by_name', 'validated_at', 'has_discrepancy',
              'note', 'updated_at'
            ])
          ) ||
          (
            resource.data.type == 'RECYCLING' &&
            resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            request.resource.data.status == resource.data.status &&
            (hasPermission('production.create') || hasPermission('production.validate')) &&
            hasStoreAccess(resource.data.destination_store_id) &&
            request.resource.data.lines is list &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines', 'updated_at'])
          ) ||
          (
            resource.data.status == 'DISCREPANCY' &&
            request.resource.data.status == 'DISCREPANCY' &&
            isAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'discrepancy_resolved', 'discrepancy_resolution_note', 'updated_at'
            ])
          )
        )
      );
      allow delete: if isSuperAdmin() && (
        resource.data.status == 'DRAFT' ||
        (resource.data.status == 'APPROVED' && !('purchase_id' in resource.data))
      );
    }
  }
}
