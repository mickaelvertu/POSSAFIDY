rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Default-deny catch-all safety net
    match /{document=**} {
      allow read, write: if false;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE' && (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['ADMIN', 'SUPER_ADMIN']
      );
    }

    function isSuperAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE' &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'SUPER_ADMIN';
    }

    function isActiveUser() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'ACTIVE';
    }

    function hasPermission(permission) {
      return isAdmin() || (
        isActiveUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.permissions.hasAny([permission])
      );
    }

    function hasStoreAccess(storeId) {
      return isAdmin() || (
        isActiveUser() && storeId is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([storeId])
      );
    }

    function canViewArticleType(articleType) {
      let profile = get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
      return isSuperAdmin() || (
        isActiveUser() && (
          ('visibleArticleTypes' in profile && profile.visibleArticleTypes.hasAny([articleType])) ||
          (!('visibleArticleTypes' in profile) && (
            profile.role in ['ADMIN', 'MAGASINIER', 'RESPONSABLE_MAGASIN', 'PRODUCTION'] ||
            (profile.role in ['VENDEUR', 'GESTIONNAIRE_CREDIT', 'REVENDEUR'] && articleType == 'RESALE')
          ))
        )
      );
    }

    // User collection access rules
    match /users/{userId} {
      allow get: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow list: if isAdmin() || (isActiveUser() && resource.data.role == 'RESPONSABLE_MAGASIN');
      allow create: if (
        isSuperAdmin() ||
        (isAdmin() && !(request.resource.data.role in ['ADMIN', 'SUPER_ADMIN'])) ||
        (
          request.auth.uid == userId &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.role == null &&
          request.resource.data.permissions.size() == 0 &&
          request.resource.data.assignedStores.size() == 0
        ) ||
        (
          request.auth.uid == userId &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.role == 'REVENDEUR' &&
          request.resource.data.businessName is string &&
          request.resource.data.businessName.size() >= 2 &&
          request.resource.data.firstName is string &&
          request.resource.data.firstName.size() >= 2 &&
          request.resource.data.lastName is string &&
          request.resource.data.lastName.size() >= 2 &&
          request.resource.data.phone is string &&
          request.resource.data.phone.size() >= 5 &&
          request.resource.data.uid == request.auth.uid &&
          request.resource.data.permissions.size() == 0 &&
          request.resource.data.assignedStores.size() == 0 &&
          request.resource.data.keys().hasOnly([
            'uid', 'email', 'firstName', 'lastName', 'businessName',
            'phone', 'status', 'role', 'permissions', 'assignedStores',
            'createdAt', 'updatedAt'
          ])
        )
      ) &&
        request.resource.data.email is string &&
        request.resource.data.status in ['PENDING', 'ACTIVE', 'DISABLED'];
      allow update: if isSignedIn() && (
        isSuperAdmin() ||
        (isAdmin() && !(resource.data.role in ['ADMIN', 'SUPER_ADMIN']) && !(request.resource.data.role in ['ADMIN', 'SUPER_ADMIN'])) ||
        (request.auth.uid == userId && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['role', 'status', 'permissions', 'assignedStores']))
      );
      allow delete: if false;
    }

    // Admins metadata collection
    match /admins/{adminId} {
      allow get: if isSignedIn() && (adminId == request.auth.uid || isAdmin());
      allow list: if isAdmin();
      allow write: if isSuperAdmin();
    }

    match /userConnections/{connectionId} {
      allow read: if isAdmin();
      allow create: if isActiveUser() &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.keys().hasOnly(['user_id', 'connected_at', 'heartbeat_at']) &&
        request.resource.data.connected_at == request.time &&
        request.resource.data.heartbeat_at == request.time;
      allow update: if isActiveUser() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.keys().hasOnly(['user_id', 'connected_at', 'heartbeat_at']) &&
        request.resource.data.connected_at == resource.data.connected_at &&
        request.resource.data.heartbeat_at == request.time;
      allow delete: if isActiveUser() && resource.data.user_id == request.auth.uid;
    }

    match /inventoryMetadata/{documentId} {
      allow read, write: if isAdmin();
    }

    match /articles/{articleId} {
      allow read: if isActiveUser() && canViewArticleType(resource.data.article_type);
      allow write: if isAdmin();
    }

    match /categories/{categoryId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /units/{unitId} {
      allow read, write: if isAdmin();
    }

    match /suppliers/{supplierId} {
      allow read, write: if isAdmin();
    }

    match /employees/{employeeId} {
      allow read: if isAdmin() || (isActiveUser() && resource.data.get('user_id', null) == request.auth.uid);
      allow create: if isAdmin() || (
        request.auth.uid == employeeId &&
        request.resource.data.keys().hasOnly([
          'id', 'user_id', 'first_name', 'last_name', 'position', 'email',
          'phone', 'application_status', 'is_active', 'created_at', 'updated_at'
        ]) &&
        request.resource.data.keys().hasAll([
          'id', 'user_id', 'first_name', 'last_name', 'position', 'email',
          'application_status', 'is_active', 'created_at', 'updated_at'
        ]) &&
        request.resource.data.id == employeeId &&
        request.resource.data.user_id == request.auth.uid &&
        request.resource.data.application_status == 'PENDING' &&
        request.resource.data.is_active == false &&
        request.resource.data.first_name is string &&
        request.resource.data.first_name.size() > 0 &&
        request.resource.data.last_name is string &&
        request.resource.data.last_name.size() > 0 &&
        request.resource.data.position is string &&
        request.resource.data.position.size() > 0 &&
        request.resource.data.email is string &&
        request.resource.data.created_at is number &&
        request.resource.data.updated_at is number &&
        (!('phone' in request.resource.data) || request.resource.data.phone is string) &&
        existsAfter(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.status == 'PENDING' &&
        getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.email == request.resource.data.email
      );
      allow update, delete: if isAdmin();
    }

    match /payroll/{payslipId} {
      allow read: if isAdmin() || (isActiveUser() &&
        get(/databases/$(database)/documents/employees/$(resource.data.employee_id)).data.get('user_id', null) == request.auth.uid);
      allow write: if isAdmin();
    }

    match /salaryAdvances/{advanceId} {
      allow read: if isAdmin() || (isActiveUser() &&
        get(/databases/$(database)/documents/employees/$(resource.data.employee_id)).data.get('user_id', null) == request.auth.uid);
      allow write: if isAdmin();
    }

    match /purchases/{purchaseId} {
      allow get: if isAdmin() || (
        isActiveUser() &&
        resource.data.status == 'APPROVED' &&
        hasStoreAccess(resource.data.store_id)
      );
      allow list: if isAdmin();
      allow create: if isAdmin() &&
        request.resource.data.id == purchaseId &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0;
      allow update: if (
        isAdmin() &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'APPROVED' &&
        resource.data.created_by != request.auth.uid &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.supplier_id == resource.data.supplier_id &&
        request.resource.data.lines == resource.data.lines &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.invoice_number == resource.data.invoice_number &&
        request.resource.data.expected_payment_at == resource.data.expected_payment_at &&
        request.resource.data.payments == resource.data.payments &&
        request.resource.data.amount_paid == resource.data.amount_paid &&
        request.resource.data.approved_by == request.auth.uid &&
        request.resource.data.transfer_id == 'trf-purchase-' + purchaseId &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'approved_by', 'approved_by_name', 'approved_at', 'transfer_id', 'updated_at'
        ]) &&
        existsAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)) &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.type == 'SUPPLIER_TO_STORE' &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.purchase_id == purchaseId &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.status == 'IN_TRANSIT' &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.approved_by == request.auth.uid &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.requested_by == resource.data.created_by &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.destination_store_id == resource.data.store_id &&
        getAfter(/databases/$(database)/documents/transfers/$(request.resource.data.transfer_id)).data.supplier_id == resource.data.supplier_id
      ) || (
        isAdmin() &&
        resource.data.get('status', 'RECEIVED') in ['APPROVED', 'RECEIVED'] &&
        request.resource.data.get('status', 'RECEIVED') == resource.data.get('status', 'RECEIVED') &&
        request.resource.data.amount_paid is number &&
        request.resource.data.amount_paid >= resource.data.amount_paid &&
        request.resource.data.amount_paid <= resource.data.total &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'amount_paid', 'payment_status', 'payments', 'updated_at'
        ])
      ) || (
        isActiveUser() &&
        resource.data.status == 'APPROVED' &&
        request.resource.data.status == 'RECEIVED' &&
        request.resource.data.transfer_id == resource.data.transfer_id &&
        hasStoreAccess(resource.data.store_id) &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.store_id]) &&
        request.resource.data.received_by is string &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'received_by', 'received_by_name', 'received_at', 'updated_at'
        ]) &&
        existsAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)) &&
        getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.status in ['VALIDATED', 'DISCREPANCY'] &&
        getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.purchase_id == purchaseId &&
        getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.received_by == request.resource.data.received_by &&
        (
          (
            get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            getAfter(/databases/$(database)/documents/transfers/$(resource.data.transfer_id)).data.validated_by == request.auth.uid &&
            request.resource.data.received_by != request.auth.uid
          ) ||
          (
            get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.store_type != 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid
          )
        )
      );
    }

    function hasExpenseStoreAccess(storeId) {
      return isSuperAdmin() || (isActiveUser() && storeId is string &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([storeId]));
    }

    function isSalaryAdvanceExpense(data) {
      return data.category == 'SALARY_ADVANCE';
    }

    function hasValidSalaryAdvanceDetails(data) {
      return ('employee_id' in data) &&
        data.employee_id is string &&
        exists(/databases/$(database)/documents/employees/$(data.employee_id)) &&
        ('employee_name' in data) &&
        data.employee_name == get(/databases/$(database)/documents/employees/$(data.employee_id)).data.first_name + ' ' +
          get(/databases/$(database)/documents/employees/$(data.employee_id)).data.last_name &&
        ('salary_advance_id' in data) &&
        data.salary_advance_id == 'advance-' + data.id &&
        data.payment_status == 'PAID' &&
        data.description is string &&
        data.description.size() > 0;
    }

    match /expenses/{expenseId} {
      allow read: if (hasPermission('expenses.view') || hasPermission('expenses.create')) &&
        (isSuperAdmin() || resource.data.created_by == request.auth.uid || hasExpenseStoreAccess(resource.data.get('store_id', null)));
      allow create: if hasPermission('expenses.create') &&
        hasExpenseStoreAccess(request.resource.data.get('store_id', null)) &&
        request.resource.data.id == expenseId &&
        request.resource.data.status == 'DRAFT' &&
        !request.resource.data.keys().hasAny(['validated_by', 'validated_at']) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.amount is number && request.resource.data.amount > 0 &&
        request.resource.data.description is string &&
        (
          (isSalaryAdvanceExpense(request.resource.data) && isAdmin() && hasValidSalaryAdvanceDetails(request.resource.data)) ||
          (!isSalaryAdvanceExpense(request.resource.data) && !request.resource.data.keys().hasAny(['employee_id', 'employee_name', 'salary_advance_id']))
        );
      allow update: if (
        hasPermission('expenses.create') &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        resource.data.created_by == request.auth.uid &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.expense_number == resource.data.expense_number &&
        request.resource.data.created_at == resource.data.created_at &&
        hasExpenseStoreAccess(request.resource.data.get('store_id', null)) &&
        (!isSalaryAdvanceExpense(resource.data) && !isSalaryAdvanceExpense(request.resource.data) || isAdmin()) &&
        (
          (isSalaryAdvanceExpense(request.resource.data) && hasValidSalaryAdvanceDetails(request.resource.data)) ||
          (!isSalaryAdvanceExpense(request.resource.data) && !request.resource.data.keys().hasAny(['employee_id', 'employee_name', 'salary_advance_id']))
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'category', 'description', 'amount', 'expense_date', 'store_id',
          'store_name', 'payee', 'employee_id', 'employee_name', 'salary_advance_id',
          'payment_method', 'payment_status', 'reference', 'notes'
        ])
      ) || (
        hasPermission('expenses.create') &&
        (isSuperAdmin() || (resource.data.created_by == request.auth.uid && hasExpenseStoreAccess(resource.data.get('store_id', null)))) &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'VALIDATED' &&
        request.resource.data.validated_by == request.auth.uid &&
        request.resource.data.validated_at is number &&
        (
          !isSalaryAdvanceExpense(resource.data) ||
          (
            isAdmin() &&
            hasValidSalaryAdvanceDetails(resource.data) &&
            existsAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)) &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.id == resource.data.salary_advance_id &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.expense_id == expenseId &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.employee_id == resource.data.employee_id &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.amount == resource.data.amount &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.advance_date == resource.data.expense_date &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.payment_method == resource.data.payment_method &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.reason == resource.data.description &&
            getAfter(/databases/$(database)/documents/salaryAdvances/$(resource.data.salary_advance_id)).data.status == 'OUTSTANDING'
          )
        ) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'validated_by', 'validated_at'])
      );
      allow delete: if isSuperAdmin();
    }

    match /movements/{movementId} {
      allow read: if isActiveUser() && hasStoreAccess(resource.data.store_id);
      allow create: if hasStoreAccess(request.resource.data.store_id) && (
        hasPermission('stock.adjust') || hasPermission('transfers.ship') ||
        hasPermission('transfers.receive') || hasPermission('sales.validate') ||
        hasPermission('production.create') || hasPermission('production.validate')
      );
    }

    match /sales/{saleId} {
      allow read: if (hasPermission('sales.view') && (resource == null || hasStoreAccess(resource.data.store_id)) || hasPermission('credit.manage'));
      allow create: if hasPermission('sales.create') &&
        request.resource.data.seller_id == request.auth.uid &&
        (request.resource.data.status == 'DRAFT' ||
          (isAdmin() && request.resource.data.status == 'VALIDATED' && request.resource.data.customer_type == 'REVENDEUR')) &&
        request.resource.data.lines is list && request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number && request.resource.data.total >= 0 &&
        request.resource.data.amount_paid is number &&
        request.resource.data.amount_paid >= 0 &&
        hasStoreAccess(request.resource.data.store_id) &&
        (
          request.resource.data.customer_type != 'REVENDEUR' ||
          (
            (isAdmin() || get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'RESPONSABLE_MAGASIN') &&
            exists(/databases/$(database)/documents/stores/$(request.resource.data.store_id)) &&
            get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            (
              (isAdmin() && request.resource.data.status == 'VALIDATED') ||
              (
                request.resource.data.credit_customer_id is string &&
                exists(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)) &&
                get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.is_active == true
              )
            ) &&
            (
              (isAdmin() && request.resource.data.status == 'VALIDATED' && !request.resource.data.keys().hasAny(['credit_customer_id'])) ||
              request.resource.data.amount_paid >= request.resource.data.total ||
              (
                hasPermission('credit.sales') &&
                request.resource.data.credit_customer_id is string &&
                exists(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)) &&
                get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.is_active == true &&
                request.resource.data.credit_due_at is number &&
                existsAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)) &&
                getAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.outstanding_balance ==
                  get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.outstanding_balance +
                  request.resource.data.total - request.resource.data.amount_paid &&
                getAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.outstanding_balance <=
                  get(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.credit_limit &&
                getAfter(/databases/$(database)/documents/creditCustomers/$(request.resource.data.credit_customer_id)).data.last_credit_sale_id == saleId
              )
            )
          )
        );
      allow update: if (
        hasPermission('sales.create') &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        resource.data.seller_id == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.sale_number == resource.data.sale_number &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.seller_id == resource.data.seller_id &&
        request.resource.data.seller_name == resource.data.seller_name &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.customer_type == resource.data.customer_type &&
        request.resource.data.get('credit_customer_id', null) == resource.data.get('credit_customer_id', null) &&
        request.resource.data.amount_paid == resource.data.amount_paid &&
        request.resource.data.payment_method == resource.data.payment_method &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number &&
        request.resource.data.total >= 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'customer_name', 'customer_phone', 'credit_due_at', 'lines', 'subtotal',
          'discount', 'tax', 'total', 'payment_status', 'change_returned', 'notes'
        ]) &&
        (
          !resource.data.keys().hasAny(['credit_customer_id']) ||
          (
            existsAfter(/databases/$(database)/documents/creditCustomers/$(resource.data.credit_customer_id)) &&
            getAfter(/databases/$(database)/documents/creditCustomers/$(resource.data.credit_customer_id)).data.outstanding_balance ==
              get(/databases/$(database)/documents/creditCustomers/$(resource.data.credit_customer_id)).data.outstanding_balance +
              request.resource.data.total - request.resource.data.amount_paid -
              resource.data.total + resource.data.amount_paid
          )
        ) &&
        hasStoreAccess(resource.data.store_id)
      ) || (
        (hasPermission('sales.edit') || hasPermission('sales.validate')) &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.seller_id == resource.data.seller_id &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.customer_type == resource.data.customer_type &&
        request.resource.data.lines == resource.data.lines &&
        request.resource.data.subtotal == resource.data.subtotal &&
        request.resource.data.discount == resource.data.discount &&
        request.resource.data.tax == resource.data.tax &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.amount_paid == resource.data.amount_paid &&
        request.resource.data.payment_method == resource.data.payment_method &&
        (
          (resource.data.status == 'DRAFT' && request.resource.data.status == 'CHECKING') ||
          (resource.data.status == 'DRAFT' && request.resource.data.status == 'CANCELLED' && isSuperAdmin()) ||
          (resource.data.status == 'CHECKING' && request.resource.data.status == 'VERIFIED') ||
          (resource.data.status == 'CHECKING' && request.resource.data.status == 'CANCELLED' && isSuperAdmin()) ||
          (resource.data.status == 'VERIFIED' && request.resource.data.status == 'CANCELLED' && isSuperAdmin()) ||
          (resource.data.status == 'VALIDATED' && request.resource.data.status == 'CANCELLED' && isSuperAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status'])) ||
          (resource.data.status == 'VERIFIED' && request.resource.data.status == 'VALIDATED' && resource.data.customer_type != 'REVENDEUR') ||
          (
            resource.data.status == 'VERIFIED' && request.resource.data.status == 'APPROVED' &&
            resource.data.customer_type == 'REVENDEUR' && isAdmin() &&
            request.resource.data.approved_by == request.auth.uid &&
            request.resource.data.approved_at is number
          ) ||
          (
            resource.data.status == 'APPROVED' && request.resource.data.status == 'CANCELLED' &&
            isSuperAdmin()
          ) ||
          (
            resource.data.status == 'APPROVED' && request.resource.data.status == 'VALIDATED' &&
            resource.data.customer_type == 'REVENDEUR' && hasPermission('sales.validate') &&
            hasStoreAccess(resource.data.store_id) &&
            request.resource.data.get('approved_by', null) == resource.data.get('approved_by', null)
          )
        ) &&
        (request.resource.data.status != 'VALIDATED' || request.resource.data.validated_by == request.auth.uid)
      ) || (
        hasPermission('credit.manage') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.seller_id == resource.data.seller_id &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.credit_customer_id == resource.data.credit_customer_id &&
        request.resource.data.total == resource.data.total &&
        request.resource.data.lines == resource.data.lines &&
        (
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'amount_paid', 'payment_status', 'credit_payments'
            ]) &&
            request.resource.data.amount_paid > resource.data.amount_paid &&
            request.resource.data.amount_paid <= resource.data.total &&
            request.resource.data.payment_status == (request.resource.data.amount_paid == resource.data.total ? 'PAID' : 'PARTIAL')
          ) ||
          (
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['credit_followups']) &&
            request.resource.data.credit_followups.size() == resource.data.get('credit_followups', []).size() + 1
          )
        )
      ) || (
        isAdmin() &&
        resource.data.status == 'VALIDATED' &&
        resource.data.payment_status != 'PAID' &&
        !resource.data.keys().hasAny(['credit_customer_id']) &&
        request.resource.data.status == resource.data.status &&
        request.resource.data.amount_paid == resource.data.total &&
        request.resource.data.payment_status == 'PAID' &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['amount_paid', 'payment_status'])
      );
      allow delete: if isSuperAdmin() && resource.data.status == 'DRAFT';
    }

    match /productions/{productionId} {
      allow read: if hasPermission('production.view') && (resource == null || hasStoreAccess(resource.data.manufacturer_store_id));
      allow create: if (hasPermission('production.create') || hasPermission('production.validate')) &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.consumptions is list && request.resource.data.consumptions.size() > 0 &&
        request.resource.data.outputs is list && request.resource.data.outputs.size() > 0 &&
        hasStoreAccess(request.resource.data.manufacturer_store_id);
      allow update: if hasPermission('production.create') &&
        resource.data.status == 'DRAFT' &&
        request.resource.data.status == 'DRAFT' &&
        resource.data.created_by == request.auth.uid &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.production_number == resource.data.production_number &&
        request.resource.data.manufacturer_store_id == resource.data.manufacturer_store_id &&
        request.resource.data.created_by == resource.data.created_by &&
        request.resource.data.created_at == resource.data.created_at &&
        request.resource.data.consumptions is list &&
        request.resource.data.consumptions.size() > 0 &&
        request.resource.data.outputs is list &&
        request.resource.data.outputs.size() > 0 &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumptions', 'outputs', 'notes']) &&
        hasStoreAccess(resource.data.manufacturer_store_id);
      allow delete: if isSuperAdmin() && resource.data.status == 'DRAFT';
    }

    match /auditLogs/{auditId} {
      allow read: if isAdmin() || (
        isActiveUser() && resource.data.user_id == request.auth.uid
      );
      allow create: if isActiveUser() && request.resource.data.user_id == request.auth.uid;
    }

    // Inventory master data. Administrators seed and maintain stores; active
    // users may read inventory, while stock adjustments require stock.adjust.
    match /stores/{storeId} {
      allow read: if isActiveUser();
      allow write: if isAdmin();
    }

    match /inventoryCounts/{countId} {
      function isCounter() {
        return isActiveUser() && (
          isAdmin() ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role in ['RESPONSABLE_MAGASIN', 'CONTROLEUR'] ||
          hasPermission('inventory.count')
        );
      }

      allow read: if isAdmin() || (isActiveUser() && (hasStoreAccess(resource.data.store_id) || resource.data.get('charged_to', null) == request.auth.uid));
      allow create: if isCounter() &&
        request.resource.data.id == countId &&
        request.resource.data.created_by == request.auth.uid &&
        (isAdmin() || hasStoreAccess(request.resource.data.store_id)) &&
        request.resource.data.status in ['DRAFT', 'AWAITING_SIGNATURE', 'SUBMITTED'] &&
        (request.resource.data.status == 'DRAFT' || (request.resource.data.status == 'AWAITING_SIGNATURE' && request.resource.data.manager_id is string) || (request.resource.data.status == 'SUBMITTED' && request.resource.data.get('signature_waived', false) == true && !('manager_signed_at' in request.resource.data)));
      allow update: if (
        isCounter() &&
        resource.data.status == 'DRAFT' &&
        resource.data.created_by == request.auth.uid &&
        request.resource.data.created_by == request.auth.uid &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.status in ['DRAFT', 'AWAITING_SIGNATURE', 'SUBMITTED'] &&
        (request.resource.data.status == 'DRAFT' || (request.resource.data.status == 'AWAITING_SIGNATURE' && request.resource.data.manager_id is string) || (request.resource.data.status == 'SUBMITTED' && request.resource.data.get('signature_waived', false) == true && !('manager_signed_at' in request.resource.data)))
      ) || (
        // Le responsable désigné signe (présence attestée) ou refuse de signer.
        isActiveUser() && resource.data.status == 'AWAITING_SIGNATURE' &&
        resource.data.manager_id == request.auth.uid &&
        request.resource.data.status in ['SUBMITTED', 'REJECTED'] &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'status', 'manager_signed_at', 'manager_signed_by', 'manager_signed_by_name', 'submitted_at',
          'reviewed_by', 'reviewed_by_name', 'reviewed_at', 'review_note', 'updated_at'
        ]) &&
        (request.resource.data.status == 'REJECTED' || request.resource.data.manager_signed_by == request.auth.uid)
      ) || (
        isAdmin() && resource.data.status == 'SUBMITTED' &&
        resource.data.created_by != request.auth.uid &&
        ('manager_signed_at' in resource.data || resource.data.get('signature_waived', false) == true) &&
        request.resource.data.status in ['VALIDATED', 'REJECTED'] &&
        request.resource.data.store_id == resource.data.store_id
      ) || (
        isAdmin() && resource.data.status == 'VALIDATED' &&
        !('charge_settlement' in resource.data) &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['charge_settlement', 'updated_at'])
      );
      allow delete: if isCounter() && resource.data.status == 'DRAFT' && resource.data.created_by == request.auth.uid;
    }

    match /creditCustomers/{customerId} {
      allow read: if hasPermission('credit.sales') || hasPermission('credit.manage') ||
        (isActiveUser() && resource.data.linked_user_id == request.auth.uid);
      allow create: if hasPermission('credit.manage') &&
        request.resource.data.id == customerId &&
        request.resource.data.credit_limit is number &&
        request.resource.data.credit_limit >= 0 &&
        request.resource.data.outstanding_balance == 0 &&
        request.resource.data.payment_term_days is int &&
        request.resource.data.payment_term_days > 0;
      allow update: if (
        hasPermission('credit.manage') &&
        request.resource.data.id == resource.data.id &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.credit_limit is number &&
        request.resource.data.credit_limit >= request.resource.data.outstanding_balance &&
        request.resource.data.payment_term_days is int &&
        request.resource.data.payment_term_days > 0
      ) || (
        hasPermission('credit.sales') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly([
          'outstanding_balance', 'last_credit_sale_id', 'updated_at'
        ]) &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.outstanding_balance <= resource.data.credit_limit &&
        request.resource.data.last_credit_sale_id is string &&
        exists(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.status == 'DRAFT' &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.status == 'DRAFT' &&
        request.resource.data.outstanding_balance - resource.data.outstanding_balance ==
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total -
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid -
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total +
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid
      ) || (
        hasPermission('credit.sales') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'updated_at']) &&
        request.resource.data.outstanding_balance < resource.data.outstanding_balance &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.last_credit_sale_id is string &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.status == 'CANCELLED' &&
        resource.data.outstanding_balance - request.resource.data.outstanding_balance ==
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total -
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid
      ) || (
        hasPermission('credit.sales') &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'last_credit_sale_id', 'updated_at']) &&
        request.resource.data.outstanding_balance > resource.data.outstanding_balance &&
        request.resource.data.outstanding_balance <= resource.data.credit_limit &&
        request.resource.data.last_credit_sale_id is string &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)) &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.total -
          getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_credit_sale_id)).data.amount_paid ==
          request.resource.data.outstanding_balance - resource.data.outstanding_balance
      ) || (
        isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'last_cancelled_credit_sale_id', 'updated_at']) &&
        request.resource.data.outstanding_balance >= 0 &&
        request.resource.data.last_cancelled_credit_sale_id is string &&
        exists(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)) &&
        existsAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)) &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.credit_customer_id == customerId &&
        get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.status == 'VALIDATED' &&
        getAfter(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.status == 'CANCELLED' &&
        resource.data.outstanding_balance - request.resource.data.outstanding_balance ==
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.total -
          get(/databases/$(database)/documents/sales/$(request.resource.data.last_cancelled_credit_sale_id)).data.amount_paid
      ) || (
        isSuperAdmin() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['outstanding_balance', 'updated_at']) &&
        request.resource.data.outstanding_balance >= 0 &&
        resource.data.last_credit_sale_id is string &&
        exists(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)) &&
        get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.credit_customer_id == customerId &&
        get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.status == 'DRAFT' &&
        !existsAfter(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)) &&
        resource.data.outstanding_balance - request.resource.data.outstanding_balance ==
          get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.total -
          get(/databases/$(database)/documents/sales/$(resource.data.last_credit_sale_id)).data.amount_paid
      );
      allow delete: if hasPermission('credit.manage') && resource.data.outstanding_balance == 0;
    }

    match /resellerOrders/{orderId} {
      allow read: if isAdmin() ||
        (isActiveUser() && resource.data.reseller_user_id == request.auth.uid &&
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'REVENDEUR');
      allow create: if isActiveUser() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'REVENDEUR' &&
        request.resource.data.id == orderId &&
        request.resource.data.reseller_user_id == request.auth.uid &&
        request.resource.data.status == 'PENDING' &&
        request.resource.data.lines is list && request.resource.data.lines.size() > 0 &&
        request.resource.data.total is number && request.resource.data.total > 0 &&
        request.resource.data.business_name is string &&
        request.resource.data.customer_phone is string &&
        request.resource.data.created_at is number &&
        request.resource.data.payment_type in ['CASH', 'CREDIT'] &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.store_id)).data.is_active == true;
      allow update: if isAdmin() &&
        request.resource.data.reseller_user_id == resource.data.reseller_user_id &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.payment_type == resource.data.payment_type &&
        resource.data.status == 'PENDING' &&
        request.resource.data.status in ['APPROVED', 'REJECTED', 'REVISION_REQUESTED'] &&
        (
          (request.resource.data.status == 'APPROVED' &&
            request.resource.data.lines is list &&
            request.resource.data.total is number &&
            request.resource.data.sale_id is string) ||
          (request.resource.data.status != 'APPROVED' &&
            request.resource.data.lines == resource.data.lines &&
            request.resource.data.total == resource.data.total)
        ) ||
        (
          isAdmin() &&
          resource.data.status == 'APPROVED' &&
          resource.data.payment_type == 'CASH' &&
          !resource.data.keys().hasAny(['cash_paid_at']) &&
          request.resource.data.status == 'APPROVED' &&
          request.resource.data.payment_type == 'CASH' &&
          request.resource.data.cash_paid_at is number &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'cash_paid_at', 'cash_paid_by', 'cash_paid_by_name', 'updated_at'
          ])
        ) ||
        (
          isActiveUser() &&
          resource.data.reseller_user_id == request.auth.uid &&
          resource.data.status == 'REVISION_REQUESTED' &&
          request.resource.data.status == 'PENDING' &&
          request.resource.data.reseller_user_id == resource.data.reseller_user_id &&
          request.resource.data.order_number == resource.data.order_number &&
          request.resource.data.business_name == resource.data.business_name &&
          request.resource.data.customer_name == resource.data.customer_name &&
          request.resource.data.customer_phone == resource.data.customer_phone &&
          request.resource.data.store_id == resource.data.store_id &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'lines', 'total', 'payment_type', 'notes', 'status', 'updated_at', 'admin_message', 'reviewed_by', 'reviewed_by_name', 'reviewed_at'
          ])
        );
      allow delete: if false;
    }

    match /resellerNotifications/{notificationId} {
      allow read: if isActiveUser() && resource.data.user_id == request.auth.uid;
      allow create: if isAdmin() &&
        request.resource.data.user_id is string &&
        request.resource.data.order_id is string &&
        request.resource.data.is_read == false &&
        exists(/databases/$(database)/documents/users/$(request.resource.data.user_id)) &&
        get(/databases/$(database)/documents/users/$(request.resource.data.user_id)).data.role == 'REVENDEUR';
      allow update: if isActiveUser() &&
        resource.data.user_id == request.auth.uid &&
        request.resource.data.user_id == resource.data.user_id &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['is_read']) &&
        request.resource.data.is_read == true;
      allow delete: if false;
    }

    match /stocks/{stockId} {
      // resource == null lets transactions probe a stock row that does not exist yet (first receipt of an article in a store)
      allow read: if isActiveUser() && (
        resource == null ||
        hasStoreAccess(resource.data.store_id) ||
        (
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'REVENDEUR' &&
          exists(/databases/$(database)/documents/stores/$(resource.data.store_id)) &&
          get(/databases/$(database)/documents/stores/$(resource.data.store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
          exists(/databases/$(database)/documents/articles/$(resource.data.article_id)) &&
          get(/databases/$(database)/documents/articles/$(resource.data.article_id)).data.article_type == 'RESALE'
        )
      );
      allow create: if hasStoreAccess(request.resource.data.store_id) &&
        request.resource.data.quantity is number && request.resource.data.quantity >= 0 && (
          hasPermission('stock.adjust') || hasPermission('transfers.ship') ||
          hasPermission('transfers.receive') || hasPermission('sales.validate') ||
          hasPermission('production.create') || hasPermission('production.validate') ||
          isSuperAdmin()
        );
      allow update: if hasStoreAccess(resource.data.store_id) &&
        request.resource.data.store_id == resource.data.store_id &&
        request.resource.data.article_id == resource.data.article_id &&
        request.resource.data.quantity is number && request.resource.data.quantity >= 0 && (
          hasPermission('stock.adjust') || hasPermission('transfers.ship') ||
          hasPermission('transfers.receive') || hasPermission('sales.validate') ||
          hasPermission('production.create') || hasPermission('production.validate') ||
          isSuperAdmin()
        );
      allow delete: if isAdmin();
    }

    match /transfers/{transferId} {
      allow read: if isActiveUser() && (
        hasStoreAccess(resource.data.source_store_id) || hasStoreAccess(resource.data.destination_store_id)
      );
      allow create: if (hasPermission('transfers.create') &&
        request.resource.data.id == transferId &&
        request.resource.data.type == 'DIRECT_DEPOSIT' &&
        request.resource.data.requested_by == request.auth.uid &&
        request.resource.data.source_store_id == request.resource.data.destination_store_id &&
        hasStoreAccess(request.resource.data.destination_store_id) &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0) || (hasPermission('transfers.create') &&
        request.resource.data.id == transferId &&
        request.resource.data.requested_by == request.auth.uid &&
        hasStoreAccess(request.resource.data.source_store_id) &&
        request.resource.data.source_store_id != request.resource.data.destination_store_id &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)).data.is_active == true &&
        request.resource.data.status == 'DRAFT' &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0) || (
        isAdmin() &&
        request.resource.data.id == transferId &&
        request.resource.data.type == 'SUPPLIER_TO_STORE' &&
        request.resource.data.status == 'IN_TRANSIT' &&
        request.resource.data.purchase_id is string &&
        request.resource.data.purchase_number is string &&
        request.resource.data.supplier_id is string &&
        request.resource.data.source_store_id == 'supplier-' + request.resource.data.supplier_id &&
        request.resource.data.approved_by == request.auth.uid &&
        request.resource.data.requested_by != request.auth.uid &&
        request.resource.data.lines is list &&
        request.resource.data.lines.size() > 0 &&
        exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
        get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
        request.resource.data.destination_store_id is string &&
        existsAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)) &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.status == 'APPROVED' &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.transfer_id == transferId &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.store_id == request.resource.data.destination_store_id &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.supplier_id == request.resource.data.supplier_id &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.supplier_name == request.resource.data.supplier_name &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.purchase_number == request.resource.data.purchase_number &&
        getAfter(/databases/$(database)/documents/purchases/$(request.resource.data.purchase_id)).data.created_by == request.resource.data.requested_by
      );
      allow update: if
        request.resource.data.id == resource.data.id &&
        request.resource.data.created_at == resource.data.created_at &&
        (
          (
          resource.data.status == 'DRAFT' &&
          request.resource.data.status == 'DRAFT' &&
          hasPermission('transfers.create') &&
          resource.data.requested_by == request.auth.uid &&
          request.resource.data.requested_by == resource.data.requested_by &&
          request.resource.data.requested_by_name == resource.data.requested_by_name &&
          (
            request.resource.data.source_store_id != request.resource.data.destination_store_id ||
            (
              resource.data.type == 'DIRECT_DEPOSIT' &&
              request.resource.data.type == 'DIRECT_DEPOSIT' &&
              get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE'
            )
          ) &&
          hasStoreAccess(request.resource.data.source_store_id) &&
          exists(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)) &&
          get(/databases/$(database)/documents/stores/$(request.resource.data.source_store_id)).data.is_active == true &&
          exists(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)) &&
          get(/databases/$(database)/documents/stores/$(request.resource.data.destination_store_id)).data.is_active == true &&
          request.resource.data.lines is list &&
          request.resource.data.lines.size() > 0 &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly([
            'type', 'source_store_id', 'destination_store_id', 'lines', 'note', 'updated_at'
          ])
        ) ||
        (
          (
            resource.data.status == 'DRAFT' &&
            request.resource.data.status == 'APPROVED' &&
            isAdmin() &&
            resource.data.requested_by != request.auth.uid &&
            request.resource.data.approved_by == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'approved_by', 'approved_by_name', 'approved_at', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'DRAFT' &&
            request.resource.data.status == 'REJECTED' &&
            isAdmin() &&
            resource.data.requested_by != request.auth.uid &&
            request.resource.data.rejected_by == request.auth.uid &&
            request.resource.data.rejection_note is string &&
            request.resource.data.rejection_note.size() > 0 &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'rejected_by', 'rejected_by_name', 'rejected_at', 'rejection_note', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'APPROVED' &&
            request.resource.data.status == 'IN_TRANSIT' &&
            hasPermission('transfers.ship') &&
            hasStoreAccess(resource.data.source_store_id) &&
            request.resource.data.shipped_by == request.auth.uid &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'shipped_by', 'shipped_by_name', 'shipped_at', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'IN_TRANSIT' &&
            request.resource.data.status == 'RECEIVED' &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid &&
            request.auth.uid != resource.data.requested_by &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.lines is list &&
            request.resource.data.has_discrepancy is bool &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lines', 'received_by', 'received_by_name', 'received_at',
              'has_discrepancy', 'note', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'RECEIVED' &&
            request.resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            resource.data.received_by is string &&
            request.resource.data.received_by == resource.data.received_by &&
            request.auth.uid != resource.data.received_by &&
            request.auth.uid != resource.data.requested_by &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.validated_by == request.auth.uid &&
            request.resource.data.lines == resource.data.lines &&
            (
              resource.data.type != 'SUPPLIER_TO_STORE' ||
              (
                resource.data.purchase_id is string &&
                existsAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)) &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.status == 'RECEIVED' &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.received_by == resource.data.received_by
              )
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'validated_by', 'validated_by_name', 'validated_at', 'updated_at'
            ])
          ) ||
          (
            resource.data.status == 'IN_TRANSIT' &&
            request.resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type != 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid &&
            request.resource.data.validated_by == request.auth.uid &&
            request.auth.uid != resource.data.requested_by &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.lines is list &&
            (
              resource.data.type != 'SUPPLIER_TO_STORE' ||
              (
                resource.data.purchase_id is string &&
                existsAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)) &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.status == 'RECEIVED' &&
                getAfter(/databases/$(database)/documents/purchases/$(resource.data.purchase_id)).data.received_by == request.auth.uid
              )
            ) &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lines', 'received_by', 'received_by_name', 'received_at',
              'validated_by', 'validated_by_name', 'validated_at', 'has_discrepancy',
              'note', 'updated_at'
            ])
          ) ||
          (
            resource.data.type == 'DIRECT_DEPOSIT' &&
            resource.data.status == 'APPROVED' &&
            request.resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            hasPermission('transfers.receive') &&
            hasStoreAccess(resource.data.destination_store_id) &&
            get(/databases/$(database)/documents/users/$(request.auth.uid)).data.assignedStores.hasAny([resource.data.destination_store_id]) &&
            get(/databases/$(database)/documents/stores/$(resource.data.destination_store_id)).data.store_type == 'CENTRAL_WAREHOUSE' &&
            request.resource.data.received_by == request.auth.uid &&
            request.resource.data.validated_by == request.auth.uid &&
            request.auth.uid != resource.data.approved_by &&
            request.resource.data.lines is list &&
            request.resource.data.lines.size() == resource.data.lines.size() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'status', 'lines', 'received_by', 'received_by_name', 'received_at',
              'validated_by', 'validated_by_name', 'validated_at', 'has_discrepancy',
              'note', 'updated_at'
            ])
          ) ||
          (
            resource.data.type == 'RECYCLING' &&
            resource.data.status in ['VALIDATED', 'DISCREPANCY'] &&
            request.resource.data.status == resource.data.status &&
            (hasPermission('production.create') || hasPermission('production.validate')) &&
            hasStoreAccess(resource.data.destination_store_id) &&
            request.resource.data.lines is list &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lines', 'updated_at'])
          ) ||
          (
            resource.data.status == 'DISCREPANCY' &&
            request.resource.data.status == 'DISCREPANCY' &&
            isAdmin() &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly([
              'discrepancy_resolved', 'discrepancy_resolution_note', 'updated_at'
            ])
          )
        )
      );
      allow delete: if isSuperAdmin() && (
        resource.data.status == 'DRAFT' ||
        (resource.data.status == 'APPROVED' && !('purchase_id' in resource.data))
      );
    }
  }
}
